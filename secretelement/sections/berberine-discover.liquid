<section class="discover">
    <div class="container">
        <div class="discover__inner">
            <h2 class="discover__title title">Discover What Makes Up Your Path to Health!</h2>
            <div class="discover__descr">Our Secret Element Sea Moss is crafted from carefully selected, high-quality ingredients to provide maximum benefits for your health. The product includes:</div>
            <div class="discover-items">
                <div class="discover-item">
                    <div class="discover-item-top">
                        <div class="discover-item__img">
                            <picture>
                                <source media="(max-width:650px)" srcset="{{ "berberine-discover-1-tablet.png" |  file_url }}">
                                <source media="(max-width:1024px)" srcset="{{ "berberine-discover-1-tablet.png" |  file_url }}">
                                <img 
                                    src="{{ "berberine-discover-1.png" |  file_url }}" 
                                    alt="Problems img"
                                    width="250"
                                    height="183"
                                    fetchpriority="low"
                                    decoding="async"
                                >
                            </picture>
                        </div>
                        <div class="discover-item-text">
                            <div class="discover-item__name">Berberine HCl (Berberis Aristata Root Extract)</div>
                            <div class="discover-item__descr">
                                Supplies essential minerals and vitamins such as iodine, calcium, magnesium, iron, and vitamins A, C, D, E, and K. Supports bone, teeth, skin health, and overall metabolism.
                            </div>
                        </div>
                    </div>
                    
                    <div class="discover-item-tags">
                        <div class="discover-item__tag">Blood sugar</div>
                        <div class="discover-item__tag">Heart health</div>
                        <div class="discover-item__tag">Metabolism boost</div>
                    </div>
                </div>
                <div class="discover-item">
                    <div class="discover-item-top">
                        <div class="discover-item__img">
                            <picture>
