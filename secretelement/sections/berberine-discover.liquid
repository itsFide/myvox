
{{ 'product-discover-4.css' | asset_url | stylesheet_tag}}
<style>
    @media screen and (max-width: 1919px) {
        .discover-item__tag {
            padding: .495vw .859vw;
        }
    }
    @media screen and (max-width: 1024px) {
        .discover-item__tag {
            padding: 1.237vw 1.107vw;
        }
    }
    @media screen and (max-width: 650px) {
        .discover-item__tag {
            padding: 7px 18px;
        }
    }
