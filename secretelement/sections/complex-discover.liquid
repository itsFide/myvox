
{% comment %} {{ 'product-discover-4.css' | asset_url | stylesheet_tag}} {% endcomment %}
{{ 'magnesium-discover.css' | asset_url | stylesheet_tag}}
<style>
    .discover-item__tag{
        padding:9.5px 14px;
    }
    .discover-items{
        width: 100%;
    }
    @media screen and (max-width:1919px){
        .discover-item__tag{
            padding:0.495vw 0.729vw;
        }
    }
    @media screen and (max-width:1024px){
        .discover-item__tag{
            padding:1.237vw 1.107vw;
        }
    }
    @media screen and (max-width:650px){
        .discover-item__tag{
            padding:7px 15px;
        }
    }
</style>
