
{{ 'product-discover-4.css' | asset_url | stylesheet_tag}}
{{ 'magnesium-discover.css' | asset_url | stylesheet_tag}}
<section class="discover">
    <div class="container">
        <div class="discover__inner">
            <h2 class="discover__title title">Discover What Makes Up Your Path to Health!</h2>
            <div class="discover__descr">Our Magnesium Glycinate Supplement features a carefully crafted blend of premium ingredients designed to support restful sleep, muscle recovery, and overall wellness. This high-quality formula includes:</div>
            <div class="discover-items">
                <div class="discover-item">
                    <div class="discover-item-top">
                        <div class="discover-item__img">
                            <picture>
                                <source media="(max-width:650px)" srcset="{{ "magnesium-discover-1-tablet.png" |  file_url }}">
                                <source media="(max-width:1024px)" srcset="{{ "magnesium-discover-1-tablet.png" |  file_url }}">
                                <img 
                                    src="{{ "magnesium-discover-1.png" |  file_url }}" 
                                    alt="Problems img"
                                    width="250"
                                    height="183"
                                    fetchpriority="low"
                                    decoding="async"
                                >
                            </picture>
                        </div>
                        <div class="discover-item-text">
                            <div class="discover-item__name">Magnesium Glycinate</div>
                            <div class="discover-item__descr">
                                A highly absorbable form of magnesium that promotes restful sleep, supports muscle function, and maintains strong bones
                            </div>
                        </div>
                    </div>
                    
                    <div class="discover-item-tags">
                        <div class="discover-item__tag">Better sleep</div>
                        <div class="discover-item__tag">Bone support</div>
                        <div class="discover-item__tag">Muscle recovery</div>
                    </div>
                </div>
                {% comment %} <div class="discover-item">
                    <div class="discover-item-top">
                        <div class="discover-item__img">
                            <picture>
                                <source media="(max-width:650px)" srcset="{{ "magnesium-discover-2-tablet.png" |  file_url }}">
                                <source media="(max-width:1024px)" srcset="{{ "magnesium-discover-2-tablet.png" |  file_url }}">
                                <img 
                                    src="{{ "magnesium-discover-2.png" |  file_url }}" 
                                    alt="Problems img"
                                    width="250"
                                    height="183"
                                    fetchpriority="low"
                                    decoding="async"
                                >
                            </picture>
                        </div>
                        <div class="discover-item-text">
                            <div class="discover-item__name">Kava Kava Root Extract</div>
                            <div class="discover-item__descr">
                                A natural extract known for its calming effects, helping to reduce stress, enhance relaxation, and improve sleep quality.
                            </div>
                        </div>
                    </div>
                    
                    <div class="discover-item-tags">
                        <div class="discover-item__tag">Stress relief</div>
                        <div class="discover-item__tag">Relaxation</div>
                        <div class="discover-item__tag">Sleep support</div>
                    </div>
                </div> {% endcomment %}
                <div class="discover-item">
                    <div class="discover-item-top">
                        <div class="discover-item__img">
                            <picture>
                                <source media="(max-width:650px)" srcset="{{ "magnesium-discover-3.png" |  file_url }}">
                                <source media="(max-width:1024px)" srcset="{{ "magnesium-discover-3-tablet.png" |  file_url }}">
                                <img 
                                    src="{{ "magnesium-discover-3.png" |  file_url }}" 
                                    alt="Problems img"
                                    width="250"
                                    height="183"
                                    fetchpriority="low"
                                    decoding="async"
                                >
                            </picture>
                        </div>
                        <div class="discover-item-text">
                            <div class="discover-item__name">Vegetable Cellulose Capsule</div>
                            <div class="discover-item__descr">
                                A clean, plant-based capsule designed for easy digestion, eco-friendly packaging, and perfect for vegan lifestyles.
                            </div>
                        </div>
                    </div>
                    
                    <div class="discover-item-tags">
                        <div class="discover-item__tag">Vegan-friendly</div>
                        <div class="discover-item__tag">Easy digestion</div>
                        <div class="discover-item__tag">Eco-conscious</div>
                    </div>
                </div>
            </div>
            <div id="discoverWrap" class="discover-btn">
                <button data-src="{{ 'Magnesium_Listing_-_new.png' | file_url }}" class="discover__btn btn">view supplement facts</button>
            </div>
        </div>
    </div>
</section>
