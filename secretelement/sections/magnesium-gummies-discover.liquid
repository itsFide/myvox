
{{ 'magnesium-discover.css' | asset_url | stylesheet_tag}}
<style>
    .discover-item__tag{
        padding:9.5px 14px;
    }
    @media screen and (max-width:1919px){
        .discover-item__tag{
            padding:0.495vw 0.729vw;
        }
    }
    @media screen and (max-width:1024px){
        .discover-item__tag{
            padding:1.237vw 1.107vw;
        }
    }
    @media screen and (max-width:650px){
        .discover-item__tag{
            padding:7px 15px;
        }
    } 
</style>
<section class="discover">
    <div class="container">
        <div class="discover__inner">
            <h2 class="discover__title title">Discover What Makes Up Your Path to Health!</h2>
            <div class="discover__descr">Our Secret Element High Absorption Magnesium+ is formulated from carefully selected, high-quality ingredients to provide maximum health benefits. The product includes:</div>
            <div class="discover-items">
                <div class="discover-item">
                    <div class="discover-item-top">
                        <div class="discover-item__img">
                            <picture>
                                <source media="(max-width:650px)" srcset="{{ "magnesium-discover-1-tablet.png" |  file_url }}">
                                <source media="(max-width:1024px)" srcset="{{ "magnesium-discover-1-tablet.png" |  file_url }}">
                                <img 
                                    src="{{ "magnesium-discover-1.png" |  file_url }}" 
                                    alt="Problems img"
                                    width="250"
                                    height="183"
                                    fetchpriority="low"
                                    decoding="async"
                                >
                            </picture>
                        </div>
                        <div class="discover-item-text">
                            <div class="discover-item__name">Magnesium Glycinate</div>
                            <div class="discover-item__descr">
                                Highly bioavailable form of magnesium that promotes better absorption, enhancing relaxation, and sleep quality
                            </div>
                        </div>
                    </div>
                    
                    <div class="discover-item-tags">
                        <div class="discover-item__tag">Enhances relaxation</div>
                        <div class="discover-item__tag">Improves sleep quality</div>
                        <div class="discover-item__tag">Boosts absorption</div>
                    </div>
                </div>
                <div class="discover-item">
                    <div class="discover-item-top">
                        <div class="discover-item__img">
                            <picture>
                                <source media="(max-width:650px)" srcset="{{ "magnesium-gummies-discover-2-tablet.png" |  file_url }}">
                                <source media="(max-width:1024px)" srcset="{{ "magnesium-gummies-discover-2-tablet.png" |  file_url }}">
                                <img 
                                    src="{{ "magnesium-gummies-discover-2.png" |  file_url }}" 
                                    alt="Problems img"
                                    width="250"
                                    height="183"
                                    fetchpriority="low"
                                    decoding="async"
                                >
                            </picture>
                        </div>
                        <div class="discover-item-text">
                            <div class="discover-item__name">Magnesium Citrate</div>
                            <div class="discover-item__descr">
                                Supports digestion and helps regulate magnesium levels in the body, improving bone health and relieving occasional constipation
                            </div>
                        </div>
                    </div>
                    
                    <div class="discover-item-tags">
                        <div class="discover-item__tag">Supports bone health</div>
                        <div class="discover-item__tag">Supports bone health</div>
                        <div class="discover-item__tag">Regulates magnesium levels</div>
                    </div>
                </div>
                <div class="discover-item">
                    <div class="discover-item-top">
                        <div class="discover-item__img">
                            <picture>
                                <source media="(max-width:650px)" srcset="{{ "magnesium-gummies-discover-3.png" |  file_url }}">
                                <source media="(max-width:1024px)" srcset="{{ "magnesium-gummies-discover-3-tablet.png" |  file_url }}">
                                <img 
                                    src="{{ "magnesium-gummies-discover-3.png" |  file_url }}" 
                                    alt="Problems img"
                                    width="250"
                                    height="183"
                                    fetchpriority="low"
                                    decoding="async"
                                >
                            </picture>
                        </div>
                        <div class="discover-item-text">
                            <div class="discover-item__name">Magnesium Malate</div>
                            <div class="discover-item__descr">
                                Best for energy production, it alleviates fatigue and is gentle on the stomach, making it ideal for long-term use
                            </div>
                        </div>
                    </div>
                    
                    <div class="discover-item-tags">
                        <div class="discover-item__tag">Boosts energy</div>
                        <div class="discover-item__tag">Reduces fatigue</div>
                        <div class="discover-item__tag">Gentle on the stomach</div>
                    </div>
                </div>
            </div>
            <div id="discoverWrap" class="discover-btn">
                <button data-src="{{ 'magnesium-gummies-listing-6.png' |  file_url }}" class="discover__btn btn">view supplement facts</button>
            </div>
        </div>
    </div> 
</section>
{% schema %}
    {
        "name": "Magnesium gummies disc",
        "class": "magnesium-gummies-discover",
        "settings": [
            
        ],
        
        "presets": [ 
            {
            "name": "Magnesium gummies disc",
            "category": "text"
            }
        ]
    
    }
{% endschema %}