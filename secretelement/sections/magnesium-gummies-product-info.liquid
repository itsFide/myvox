        // =========================================================================
        // ОСНОВНАЯ ЛОГИКА РАБОТЫ С ПРОДУКТОМ
        // =========================================================================
        document.querySelectorAll('.buy-product').forEach(function(productBlock) {
            // Текущий выбранный вкус (по умолчанию "mango")
            let currentFlavor = 'orange';
            let discoverBtn = document.querySelector('.discover__btn')
            let discoverBtnSrc = discoverBtn.getAttribute('data-src')
            // Функция обновления названия продукта и слайдера в зависимости от вкуса
            function updateProductForFlavor() {
            // Обновление названия продукта
            let titleElements = productBlock.querySelectorAll('.buy-product__title');
            titleElements.forEach(function(titleElement) {
                titleElement.innerHTML = flavorData[currentFlavor].name;
            });
            if(currentFlavor == 'orange'){
                discoverBtn.setAttribute('data-src', '{{ 'magnesium-gummies-listing-6.png' |  file_url }}')
                discoverImg.refresh()
            } else{
                discoverBtn.setAttribute('data-src', '{{ 'SE_MC_listing_6.png' |  file_url }}')
                discoverImg.refresh()
            }
            // Обновление слайдера с изображениями
            let slides = productBlock.querySelectorAll('.productMainImgSlider .swiper-slide');
            if (slides.length) {
                const currentFlavorImages = flavorData[currentFlavor].sliderImages;
                // Сначала скрываем все слайды
                slides.forEach((slide, index) => {
                    if (index < currentFlavorImages.length) {
                        // Показываем и обновляем только нужные слайды
                        const imageUrl = currentFlavorImages[index];
                        const img = slide.querySelector('img');
                        if (img) {
                            img.src = imageUrl;
                            slide.setAttribute('data-src', imageUrl);
                            slide.style.display = 'block';
                        }
                    } else {
                        // Скрываем лишние слайды
                        slide.style.display = 'none';
                    }
                });
                
                // Обновляем Swiper
                if (swiperMain) {
                swiperMain.update();
                }
            }

            // Обновление миниатюр в галерее
            let thumbSlides = productBlock.querySelectorAll('.buy-product-thumb-slider .swiper-slide');
            if (thumbSlides.length) {
                const currentFlavorThumbs = flavorData[currentFlavor].thumbImages;
                // Обновляем и показываем/скрываем миниатюры
                thumbSlides.forEach((slide, index) => {
                    if (index < currentFlavorThumbs.length) {
                        // Показываем и обновляем только нужные миниатюры
                        const imageUrl = currentFlavorThumbs[index];
                        const img = slide.querySelector('img');
                        if (img) {
                            img.src = imageUrl;
                            slide.style.display = 'block';
                        }
                    } else {
                        // Скрываем лишние миниатюры
                        slide.style.display = 'none';
                    }
                });
                
                // Обновляем Swiper для миниатюр
                if (swiper2) {
                    swiper2.update();
                }
            }
            
            // Обновление изображений в tub-ах
            let tubs = productBlock.querySelectorAll('.buy-product-tub');
            tubs.forEach(function(tub) {
                let dataTub = tub.getAttribute('data-tub');
                let img = tub.querySelector('.buy-product-tub__img img');
                if (img && flavorData[currentFlavor].tubImages[dataTub]) {
                img.src = flavorData[currentFlavor].tubImages[dataTub];
                }

                // Обновляем текст скидки для каждого tub
                let each = tub.querySelector('.buy-product-tub__each');
                if (each) {
                    const prices = flavorData[currentFlavor].prices[dataTub];
                    const isAutoship = productBlock.querySelector('.buy-product-type.buy-product-type__second.active');
                    
                    if (isAutoship) {
                        // Для автоподписки
                        const oldPrice = parseFloat(prices.oldPriceAutoship.replace('$', ''));
                        const autoshipPrice = parseFloat(prices.priceAutoship.replace('$', ''));
                        const saveAmount = oldPrice - autoshipPrice;
                        each.textContent = `save $${saveAmount.toFixed(2)}`;
                    } else {
                        // Для разовой покупки
                        const oldPrice = parseFloat(prices.oldPrice.replace('$', ''));
                        const newPrice = parseFloat(prices.price.replace('$', ''));
                        const saveAmount = oldPrice - newPrice;
                        each.textContent = `save $${saveAmount.toFixed(2)}`;
                    }
                }
            });
            
            // Обновление цен
            updatePrices();
            
            // Обновление ссылок
            updateLinksAndPrices();
            galleryZoom.refresh();
            }

            // Функция обновления цен
            function updatePrices() {
            let activeTub = productBlock.querySelector('.buy-product-tub.active')?.getAttribute('data-tub') || "1";
            let prices = flavorData[currentFlavor].prices[activeTub];
            let isAutoship = productBlock.querySelector('.buy-product-type.buy-product-type__second.active');
            let deliveryItem = productBlock.querySelector('.buy-product-type-select__trigger p')?.innerText || "Delivery every 1 month";
            const oneTimeBlock = productBlock.querySelector('.buy-product-type:not(.buy-product-type__second)');
            if (oneTimeBlock) {
                const shippingEl = oneTimeBlock.querySelector('.buy-product-type__shipping');
                if (shippingEl) {
                // при одной банке — скрываем, при 2 или 3 — показываем
                shippingEl.style.display = (activeTub === "1") ? 'none' : '';
                }
            }
            // Обновляем цены для обычной покупки
            productBlock.querySelector('.buy-product__old-price').innerText = prices.oldPrice;
            productBlock.querySelector('.buy-product__price').innerText = prices.price;

            // Обновляем цены для автоподписки
            productBlock.querySelector('.buy-product__old-price--autoship').innerText = prices.oldPriceAutoship;
            productBlock.querySelector('.buy-product__price--autoship').innerText = prices.priceAutoship;

            // Обновляем текст экономии для всех tubs
            let tubs = productBlock.querySelectorAll('.buy-product-tub');
            tubs.forEach(tub => {
                const tubNumber = tub.getAttribute('data-tub');
                const tubPrices = flavorData[currentFlavor].prices[tubNumber];
                const each = tub.querySelector('.buy-product-tub__each');
                
                if (each) {
                    if (isAutoship) {
                        // Для автоподписки
                        const oldPrice = parseFloat(tubPrices.oldPriceAutoship.replace('$', ''));
                        const autoshipPrice = parseFloat(tubPrices.priceAutoship.replace('$', ''));
                        const saveAmount = oldPrice - autoshipPrice;
                        each.textContent = `save $${saveAmount.toFixed(2)}`;
                    } else {
                        // Для разовой покупки
                        const oldPrice = parseFloat(tubPrices.oldPrice.replace('$', ''));
                        const newPrice = parseFloat(tubPrices.price.replace('$', ''));
                        const saveAmount = oldPrice - newPrice;
                        each.textContent = `save $${saveAmount.toFixed(2)}`;
                    }
                }
            });

            // Обновляем финальную цену
            productBlock.querySelector('.final-price').innerText = isAutoship ? prices.priceAutoship : prices.price;

            // Обновляем цены в списке и периодичность доставки
            if (isAutoship) {
                productBlock.querySelector('.list-price').innerText = prices.priceAutoship;
                // Устанавливаем периодичность доставки в зависимости от выбранной частоты доставки
                switch(deliveryItem) {
                    case "Delivery every 1 month":
                        productBlock.querySelector('.list-month').innerText = "Every Month";
                        break;
                    case "Delivery every 2 months":
                        productBlock.querySelector('.list-month').innerText = "Every 2 Months";
                        break;
                    case "Delivery every 3 months":
                        productBlock.querySelector('.list-month').innerText = "Every 3 Months";
                        break;
                }
            } else {
                productBlock.querySelector('.list-price').innerText = prices.price;
                productBlock.querySelector('.list-month').innerText = "One-time";
            }
            }
            
            // Функция обновления ссылок и цен
            function updateLinksAndPrices() {
            let activeTub = productBlock.querySelector('.buy-product-tub.active')?.getAttribute('data-tub') || "1";
            let btn = document.querySelector('.buy-product-type__btn');
            let isAutoship = productBlock.querySelector('.buy-product-type.buy-product-type__second.active');
            
            if (btn) {
                if (isAutoship) {
                let deliveryItem = productBlock.querySelector('.buy-product-type-select__trigger p').innerText;
                btn.href = flavorData[currentFlavor].links[activeTub][deliveryItem];
                } else {
                btn.href = flavorData[currentFlavor].otpLinks[activeTub];
                }
            }
            }
            
            // Изначально обновляем блок под вкус по умолчанию
            updateProductForFlavor();
        
            // -------------------------------------------------------------------------
            // Обработка переключения вкуса
            // -------------------------------------------------------------------------
            var flavorItems = productBlock.querySelectorAll('.flavour-item, .flavour-item-soon');
            flavorItems.forEach(function(item) {
            item.addEventListener('click', function() {
                // Снимаем класс active со всех элементов вкуса и отмечаем выбранный
                flavorItems.forEach(function(el) {
                el.classList.remove('active');
                });
                item.classList.add('active');
                
                // Получаем название выбранного вкуса
                currentFlavor = item.querySelector('.flavour-item__name').innerText.trim().toLowerCase();
                
                // Обновляем все элементы продукта
                updateProductForFlavor();
            });
            });
            
            // -------------------------------------------------------------------------
            // Остальная логика переключения вариантов ("tub", тип покупки, доставка и т.д.)
            // -------------------------------------------------------------------------
            let tubs = productBlock.querySelectorAll('.buy-product-tub');
            let productTypes = productBlock.querySelectorAll('.buy-product-type');
            var trigger = productBlock.querySelector('.buy-product-type-select__trigger');
            var items = productBlock.querySelector('.buy-product-select-items');
            var selectItems = productBlock.querySelectorAll('.buy-product-select-item');
            
            // Переключение вариантов упаковки (tub)
            tubs.forEach((tub) => {
            tub.addEventListener('click', () => {
                tubs.forEach((tub2) => {
                tub2.classList.remove('active');
                });
                tub.classList.add('active');
                
                // Обновляем месяц доставки в зависимости от выбранного tub
                let activeTub = tub.getAttribute('data-tub');
                let trigger = productBlock.querySelector('.buy-product-type-select__trigger p');
                let selectItems = productBlock.querySelectorAll('.buy-product-select-item');
                
                switch(activeTub) {
                    case "1":
                        trigger.innerText = "Delivery every 1 month";
                        selectItems.forEach((item, index) => {
                            item.classList.remove('active');
                            if (index === 0) item.classList.add('active');
                        });
                        break;
                    case "2":
                        trigger.innerText = "Delivery every 2 months";
                        selectItems.forEach((item, index) => {
                            item.classList.remove('active');
                            if (index === 1) item.classList.add('active');
                        });
                        break;
                    case "3":
                        trigger.innerText = "Delivery every 3 months";
                        selectItems.forEach((item, index) => {
                            item.classList.remove('active');
                            if (index === 2) item.classList.add('active');
                        });
                        break;
                }
                
                updatePrices();
                updateLinksAndPrices();
            });
            });
            
            // Переключение типа покупки
            productTypes.forEach((productType) => {
            productType.addEventListener('click', () => {
                productTypes.forEach(productType2 => productType2.classList.remove('active'));
                productType.classList.add('active');
                
                // Обновляем текст экономии для всех tubs при смене типа покупки
                let tubs = productBlock.querySelectorAll('.buy-product-tub');
                let isAutoship = productType.classList.contains('buy-product-type__second');
                
                tubs.forEach(tub => {
                    const tubNumber = tub.getAttribute('data-tub');
                    const prices = flavorData[currentFlavor].prices[tubNumber];
                    const each = tub.querySelector('.buy-product-tub__each');
                    
                    if (each) {
                        if (isAutoship) {
                            // Для автоподписки
                            const oldPrice = parseFloat(prices.oldPriceAutoship.replace('$', ''));
                            const autoshipPrice = parseFloat(prices.priceAutoship.replace('$', ''));
                            const saveAmount = oldPrice - autoshipPrice;
                            each.textContent = `save $${saveAmount.toFixed(2)}`;
                        } else {
                            // Для разовой покупки
                            const oldPrice = parseFloat(prices.oldPrice.replace('$', ''));
                            const newPrice = parseFloat(prices.price.replace('$', ''));
                            const saveAmount = oldPrice - newPrice;
                            each.textContent = `save $${saveAmount.toFixed(2)}`;
                        }
                    }
                });
                
                updatePrices();
                updateLinksAndPrices();
            });
            });
            
            // Переключение видимости блока выбора доставки
            trigger.addEventListener('click', function() {
            items.style.display = items.style.display === 'block' ? 'none' : 'block';
            });
            
            // Обработка клика по элементам выбора доставки
            selectItems.forEach(function(item) {
            item.addEventListener('click', function() {
                selectItems.forEach(function(subItem) {
                subItem.classList.remove('active');
                });
                item.classList.add('active');
                var text = item.querySelector('p').textContent;
                trigger.querySelector('p').textContent = text;
                
                updatePrices();
                updateLinksAndPrices();
                items.style.display = 'none';
            });
            });
        });
    })
