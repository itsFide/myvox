{{ 'main-page-faq.css' | asset_url | stylesheet_tag}}
<section id="faq" class="faq">
    <div class="container">
        <div class="faq-bg">
            <img 
                src="{{ "se-faq-bg.png" |  file_url }}" 
                alt="Product img"
                width="827"
                height="705"
                fetchpriority="low"
                decoding="async"
            >
        </div>
        <div class="faq__inner">
            <div class="faq__left">
                
                <h2 class="faq__title title">Your Questions – Our Answers!</h2>
                <p class="faq__descr">In this section, we have collected and answered the most frequently asked questions about our product so that you can make your purchasing decision with complete confidence.</p>
            </div>
            <div class="faq__right">
                <div class="accordion">
                    <div class="accordion-item">
                        <div class="accordion-header"><p>What is Secret Element products?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>Secret Element products are premium dietary supplements focused on supporting overall health and wellness. They are crafted with clean, high-quality ingredients and are designed to target specific health needs, such as immune support, digestion, cardiovascular health, and more. These supplements are clinically tested and formulated to help users achieve their wellness goals with effective, science-backed solutions.</p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>How should I take the product?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Take 2 capsules every day with a glass of water during a meal. This ensures optimal absorption of the active ingredients.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>When will I see the first results?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Initial improvements are typically noticeable within a few weeks of regular use. For maximum benefit, it is recommended to take the product for at least three months.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Is the product safe for long-term use?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Yes, our product is made from natural ingredients and is safe for long-term use. It is free from GMOs, gluten, artificial fillers, and dairy.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Are there any side effects?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                In most cases, there are no side effects. However, if you are allergic to citrus or other components, please consult your doctor before starting the supplement.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Can I take the product with other supplements or medications?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Yes, Secret Element Citrus Bergamot can be taken with other supplements. If you are on medication, especially for managing cholesterol or blood sugar, consult your doctor.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Is the product suitable for vegans?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Yes, our product is completely vegan and contains no animal products.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Where is Secret Element Citrus Bergamot produced?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Our product is manufactured in the USA at a cGMP-certified facility, ensuring high quality and safety.
                            </p>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header"><p>What are the shipping terms?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                We offer shipping across the USA within 2-4 business days.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Is there a guarantee on the product?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                We stand by the quality of our product and offer a 30-day money-back guarantee if you are not satisfied with the results.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    document.querySelectorAll('.accordion-header').forEach(item => {
        item.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            document.querySelectorAll('.accordion-header').forEach(header => header.classList.remove('active'));
            document.querySelectorAll('.accordion-content').forEach(content => {
                content.style.maxHeight = '0';
            });

            if (!isActive) {
                item.classList.add('active');
                const content = item.nextElementSibling;
                content.style.maxHeight = content.scrollHeight + 'px';
            }
        });
    });
</script>

