{{ 'main-page-maximize.css' | asset_url | stylesheet_tag}}

<section class="maximize">
    <div class="container">
        <div class="maximize__inner">
            <div class="maximize__text">
                <h2 class="maximize__title title">Maximize Your Savings with the Secret Element Subscription</h2>
                <p class="maximize__descr">Ready for amazing savings? We’ve made it easy: <br><br>
                <strong>1 Pack: Enjoy 33% off</strong> <br>
                <strong>2 Packs: Get 40% off</strong> <br>
                <strong>3 Packs: Save a whopping 43%</strong>
                <br><br>
                Stocking up means you’ll always have what you need—no last-minute store runs. Plus, you’ll save more with every extra pack you add to your cart. It’s a win-win for your wallet and your peace of mind. <br> <br>
                <strong>Don’t miss out on these exclusive bulk discounts. Shop now, save big, and enjoy the convenience of having a long-term supply at your fingertips!</strong>
                </p>
                <div class="maximize__img show-tablet">
                    <picture>
                        <source media="(max-width:650px)" srcset="{{ "maximize-img-mobile.png" |  file_url }}">
                        <img 
                            src="{{ "maximize-img-tablet.png" |  file_url }}" 
                            alt="Problems img"
                            width="593"
                            height="700"
                            fetchpriority="low"
                            decoding="async"
                            loading="lazy"
                        >
                    </picture>
                    
                </div>
                <a href="#product-list" class="maximize__btn btn-green">Try our bestsellers</a>
            </div>
        </div>
    </div>
</section>

{% schema %}
    {
        "name": "Main page maximize",
        "class": "main-page-maximize",
        "settings": [
            
        ],
        
        "presets": [
            {
            "name": "Main page maximize",
            "category": "text"
            }
        ]
    
    }
{% endschema %}