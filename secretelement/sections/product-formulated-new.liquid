
{{ 'product-formulated.css' | asset_url | stylesheet_tag}}
<section class="formulated pt-140">
    <div class="container">
        <div class="formulated__inner">
            <h2 class="formulated__title title text-center">{{ section.settings.section_title }}</h2>
            <div class="formulated-items">
                {% for block in section.blocks %}
                    <div class="formulated-item">
                        <div class="formulated-item__icon">
                            <img src="//secretelement.com/cdn/shop/{{ block.settings.icon }}"
                            alt=""
                            width="54"
                            height="54"
                            fetchpriority="low"
                            decoding="async"
                            >
                        </div>
                        <div class="formulated-item__name">{{ block.settings.title }}</div>
                        <div class="formulated-item__descr">
                            {{ block.settings.text }}
                        </div>
                    </div>
                    
                        
                {% endfor %}
                {% comment %} <div class="formulated-item">
                    <div class="formulated-item__icon">
                        <img src="{{ "se-formulated-icon-1.svg" |  file_url }}"
                        alt=""
                        width="54"
                        height="54"
                        fetchpriority="low"
                        decoding="async"
                        >
                    </div>
                    <div class="formulated-item__name">Heart Health</div>
                    <div class="formulated-item__descr">
                        Helps lower bad cholesterol (LDL) and raise good cholesterol (HDL).
                    </div>
                </div>
                <div class="formulated-item">
                    <div class="formulated-item__icon">
                        <img src="{{ "se-formulated-icon-2.svg" |  file_url }}"
                        alt=""
                        width="54"
                        height="54"
                        fetchpriority="low"
                        decoding="async"
                        >
                    </div>
                    <div class="formulated-item__name">Blood Sugar Control</div>
                    <div class="formulated-item__descr">
                        Maintains steady blood sugar, preventing spikes and crashes.
                    </div>
                </div>
                <div class="formulated-item">
                    <div class="formulated-item__icon">
                        <img src="{{ "se-formulated-icon-3.svg" |  file_url }}"
                        alt=""
                        width="54"
                        height="54"
                        fetchpriority="low"
                        decoding="async"
                        >
                    </div>
                    <div class="formulated-item__name">Anti-Inflammatory Benefits</div>
                    <div class="formulated-item__descr">
                        Contains natural flavonoids that help reduce inflammation throughout the body.
                    </div>
                </div>
                <div class="formulated-item">
                    <div class="formulated-item__icon">
                        <img src="{{ "se-formulated-icon-4.svg" |  file_url }}"
                        alt=""
                        width="54"
                        height="54"
                        fetchpriority="low"
                        decoding="async"
                        >
                    </div>
                    <div class="formulated-item__name">Fights free radicals</div>
                    <div class="formulated-item__descr">
                        Rich in antioxidants like naringin and neohesperidin to protect your cells.
                    </div>
                </div>
                <div class="formulated-item">
                    <div class="formulated-item__icon">
                        <img src="{{ "se-formulated-icon-5.svg" |  file_url }}"
                        alt=""
                        width="54"
                        height="54"
                        fetchpriority="low"
                        decoding="async"
                        >
                    </div>
                    <div class="formulated-item__name">Stress-Free Wellness</div>
                    <div class="formulated-item__descr">
                        Provides heart health support without the unwanted side effects of medications.
                    </div>
                </div>
                <div class="formulated-item">
                    <div class="formulated-item__icon">
                        <img src="{{ "se-formulated-icon-6.svg" |  file_url }}"
                        alt=""
                        width="54"
                        height="54"
                        fetchpriority="low"
                        decoding="async"
                        >
                    </div>
                    <div class="formulated-item__name">Improved Longevity</div>
                    <div class="formulated-item__descr">
                        Combines high-quality ingredients to enhance health and longevity.
                    </div>
                </div> {% endcomment %}
            </div>
        </div>
        <button class="formulated__btn btn-green show-tablet scroll-btn">Try Today – Save Up to 50%</button>
    </div>
</section>
{% schema %}
    {
        "name": "Product formulated New",
        "class": "product-formulated-info-new",
        "settings": [
        {
            "type": "text",
            "id": "section_title",
            "label": "Заголовок секции",
            "default": "Наши преимущества"
        }
        ],
        "blocks": [
        {
            "type": "element",
            "name": "Элемент",
            "settings": [
            {
                "type": "image_picker",
                "id": "icon",
                "label": "Иконка"
            },
            {
                "type": "text",
                "id": "title",
                "label": "Заголовок"
            },
            {
                "type": "textarea",
                "id": "text",
                "label": "Описание"
            }
            ]
        }
        ],
        "max_blocks": 8,
        "presets": [
        {
            "name": "Product formulated New",
            "category": "Text"
        }
        ]
    }
    {% endschema %}