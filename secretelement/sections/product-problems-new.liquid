
{{ 'product-problems.css' | asset_url | stylesheet_tag}}
<section class="problems">
    <div class="container">
        <div class="problems__inner">
            <div class="problems__img">
                <picture>
                    <source media="(max-width:650px)" srcset="//secretelement.com/cdn/shop/{{ section.settings.section_image_mobile }}">
                    <source media="(max-width:1024px)" srcset="//secretelement.com/cdn/shop/{{ section.settings.section_image_tablet }}">
                    <img 
                        src="//secretelement.com/cdn/shop/{{ section.settings.section_image_desktop }}" 
                        alt="Problems img"
                        width="586"
                        height="639"
                        fetchpriority="low"
                        decoding="async"
                    >
                </picture>
            </div>
            <div class="problems__text">
                <h2 class="title problems__title">{{ section.settings.section_heading }}</h2>
                <div class="problems-list land-list">
                    <ul>
                        {% for block in section.blocks %}
                            <li>{{ block.settings.item_text }}</li>
                            {% comment %} <li> Medications often cause side effects that worsen overall well-being</li>
                            <li> Caring for heart health turns into daily stress</li>
                            <li> Regular blood sugar spikes negatively impact energy and mood</li>
                            <li> Attempts to find effective solutions often end in disappointment</li> {% endcomment %}
                        {% endfor %}
                    </ul>
                </div>
                <div class="problems__descr">{{ section.settings.section_descr }}</div>
                <button class="btn-green problems__btn">Try Today – Save Up to 50%</button>
            </div>
        </div>
    </div>
</section>
{% schema %}
    {
        "name": "Problems New",
        "class": "product-problems-new",
        "settings": [
            {
            "type": "text",
            "id": "section_heading",
            "label": "Заголовок секции",
            "default": "Наши проблемы"
            },
            {
            "type": "text",
            "id": "section_descr",
            "label": "Текст секции"
            },
            {
            "type": "image_picker",
                "id": "section_image_desktop",
                "label": "Картинка для ПК"
            },
            {
                "type": "image_picker",
                "id": "section_image_tablet",
                "label": "Картинка для планшета"
            },
            {
                "type": "image_picker",
                "id": "section_image_mobile",
                "label": "Картинка для телефона"
            }
        ],
        "blocks": [
            {
            "type": "item",
            "name": "Элемент списка",
            "settings": [
                {
                "type": "textarea",
                "id": "item_text",
                "label": "Текст элемента"
                }
            ]
            }
        ],
        "presets": [
            {
            "name": "Problems New",
            "category": "text"
            }
        ]
    
    }
{% endschema %}