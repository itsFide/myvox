{{ 'product-faq.css' | asset_url | stylesheet_tag}}
<section class="faq">
    <div class="container">
        <div class="faq-bg">
            <img 
                src="{{ "faq-all-bg.png" |  file_url }}" 
                alt="Product img"
                width="838"
                height="779"
                fetchpriority="low"
                decoding="async"
            >
        </div>
        <div class="faq__inner">
            <div class="faq__left">
                
                <h2 class="faq__title title">{{ section.settings.section_heading }}</h2>
                <p class="faq__descr">{{ section.settings.section_descr }}</p>
            </div>
            <div class="faq__right">
                <div class="accordion">
                    {% for block in section.blocks %}
                    <div class="accordion-item">
                        <div class="accordion-header">
                        <p>{{ block.settings.question }}</p>
                        <div class="accordion-header__icon"></div>
                        </div>
                        <div class="accordion-content">
                        <p>{{ block.settings.answer }}</p>
                        </div>
                    </div>
                    {% endfor %}
                    {% comment %} <div class="accordion-item">
                        <div class="accordion-header"><p>What is Secret Element Sea Moss?</p> 
                        <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>Secret Element Sea Moss is a natural supplement designed to support thyroid health, improve the immune system, digestion, and skin condition.</p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>How should I take the product?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Take 3 capsules daily with a glass of water during meals. This ensures optimal absorption of the active ingredients.

                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>When will I see the first results?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Initial improvements are usually noticeable within a few days of regular use. For maximum effect, it is recommended to take the product for at least three months.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Is the product safe for long-term use?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Yes, our product is made from natural ingredients and is safe for long-term use. It contains no GMOs, gluten, artificial fillers, or dairy.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Are there any side effects?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                In most cases, there are no side effects. However, if you are allergic to seaweed or other components, consult your doctor before starting.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Can I take the product with other supplements or medications?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Yes, Secret Element Sea Moss can be taken with other supplements. If you are on medication, consult your doctor to ensure safety.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Is the product suitable for vegans?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Yes, our product is completely vegan and contains no animal products.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Where is Secret Element Sea Moss made?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                Our product is made in the USA in a cGMP-certified facility, ensuring high quality and safety.
                            </p>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header"><p>What are the shipping terms?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                We ship throughout the USA within 2-4 business days.
                            </p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <div class="accordion-header"><p>Is there a guarantee on the product?</p> <div class="accordion-header__icon"></div></div>
                        <div class="accordion-content">
                            <p>
                                We are confident in the quality of our product and offer a 30-day money-back guarantee if you are not satisfied with the results.
                            </p>
                        </div>
                    </div> {% endcomment %}
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    document.querySelectorAll('.accordion-header').forEach(item => {
        item.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            document.querySelectorAll('.accordion-header').forEach(header => header.classList.remove('active'));
            document.querySelectorAll('.accordion-content').forEach(content => {
                content.style.maxHeight = '0';
            });

            if (!isActive) {
                item.classList.add('active');
                const content = item.nextElementSibling;
                content.style.maxHeight = content.scrollHeight + 'px';
            }
        });
    });
</script>
{% schema %}
    {
        "name": "Store FAQ",
        "class": "store-faq",
        "settings": [
            {
            "type": "text",
            "id": "section_heading",
            "label": "Заголовок секции",
            "default": "Your Questions – Our Answers!"
            },
            {
            "type": "text",
            "id": "section_descr",
            "label": "Описание секции",
            "default": "In this section, we have collected and answered the most frequently asked questions about our product so that you can make your purchasing decision with complete confidence."
            }
        ],
        "blocks": [
        {
        "type": "faq_item",
        "name": "FAQ Item",
        "settings": [
            {
            "type": "text",
            "id": "question",
            "label": "Вопрос",
            "default": "What is Secret Element Sea Moss?"
            },
            {
            "type": "textarea",
            "id": "answer",
            "label": "Ответ",
            "default": "Secret Element Sea Moss is a natural supplement designed to support thyroid health, improve the immune system, digestion, and skin condition."
            }
        ]
        }
    ],
        "presets": [
            {
            "name": "Store FAQ",
            "category": "text"
            }
        ]
    
    }
{% endschema %}