{% schema %}
    {
        "name": "Text reviews New",
        "class": "text-reviews-new",
        "settings": [
            {
            "type": "text",
            "id": "section_heading",
            "label": "Заголовок секции",
            "default": "Why Do Our Customers Choose Us Again and Again?"
            }
        ],
        "blocks": [
            {
            "type": "item",
            "name": "Отзыв",
            "settings": [
                {
                "type": "image_picker",
                "id": "reviews_img",
                "label": "Картинка отзыва"
                },
                {
                "type": "text",
                "id": "reviews_name",
                "label": "Имя"
                },
                {
                "type": "text",
                "id": "reviews_age",
                "label": "Возраст"
                },
                {
                "type": "text",
                "id": "reviews_descr",
                "label": "Описание"
                },
            ]
            }
        ],
        "presets": [
            {
            "name": "Text reviews New",
            "category": "text"
            }
        ]
    
    }
{% endschema %}