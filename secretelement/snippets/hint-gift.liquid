{{  
    'hint-gift.css'
    | asset_url
    | stylesheet_tag
}}
<div class="hint-modal hint">
    <div class="hint-modal-body">
        <div class="close-hint">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 22C17.5 22 22 17.5 22 12C22 6.5 17.5 2 12 2C6.5 2 2 6.5 2 12C2 17.5 6.5 22 12 22Z" stroke="#292D32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.16998 14.8299L14.83 9.16992" stroke="#292D32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14.83 14.8299L9.16998 9.16992" stroke="#292D32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>

        </div>
        <h2 class="hint__title">Shall We Hint About the Gift?</h2>
        <p class="hint__descr">*All fields marked with an asterisk are required to be filled out.</p>
        <form action="" method="post" id="hint-modal" class="hint-form">
            <div class="hint-form-item">
                <div class="hint-form-item__title">your NAME*</div>
                <input required type="text" id="name" name="customer-name" placeholder="Type the name">
            </div>
            <div class="hint-form-item">
                <div class="hint-form-item__title">your EMAIL*</div>
                <input required type="text" name="email" placeholder="Type your email adress">
            </div>
            <div class="hint-form-item">
                <div class="hint-form-item__title">Your friend's name*</div>
                <input required type="text" name="friend-name" placeholder="Type your friend's name">
            </div>
            <div class="hint-form-item">
                <div class="hint-form-item__title">Your friend's email*</div>
                <input required type="text" name="friend-email" placeholder="Type your friend's email">
            </div>
            <div class="hint-items hide-mobile">
                <h3 class="hint-items__title">Choose one or more Gifts*</h3>
                <div class="hint-items-wrapper">
                    <div data-product="Citrus Bergamot Capsules" class="hint-item">
                        <div class="hint-item__img">
                            <img
                                src="{{ 'header-product-1.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__title hide-mobile">Citrus Bergamot <br> Capsules</div>
                        <div class="hint-item__title show-mobile">Citrus Bergamot Capsules</div>
                    </div>
                    <div data-product="Sea Moss Capsules" class="hint-item">
                        <div class="hint-item__img">
                            <img
                                src="{{ 'header-product-2.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__title hide-mobile">Sea Moss <br> Capsules</div>
                        <div class="hint-item__title show-mobile">Sea Moss Capsules</div>
                    </div>
                    <div data-product="Berberine Capsules" class="hint-item">
                        <div class="hint-item__img">
                            <img
                                src="{{ 'header-product-3.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__title hide-mobile">Berberine <br>
                            Capsules</div>
                        <div class="hint-item__title show-mobile">Berberine
                            Capsules</div>
                    </div>
                    {% comment %} <div data-product="Shilajit + Ashwagandha Capsules" class="hint-item">
                        <div class="hint-item__img">
                            <img
                                src="{{ 'header-product-4.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__title">Shilajit + Ashwagandha
                            Capsules</div>
                    </div> {% endcomment %}
                    <div data-product="Sea Moss + Black Seed oil Capsules" class="hint-item">
                        <div class="hint-item__img">
                            <img
                                src="{{ 'header-product-5.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__title">Sea Moss + Black Seed oil
                            Capsules</div>
                    </div>

                    <div data-product="Magnesium Gummies" class="hint-item">
                        <div class="hint-item__img">
                            <img
                                src="{{ 'magnesium-gummies-img.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__title">Magnesium Gummies</div>
                    </div>
                    <div data-product="Magnesium Glycinate Capsules" class="hint-item">
                        <div class="hint-item__img">
                            <img
                                src="{{ 'magnesium-capsules-header-img.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__title">Magnesium Glycinate
                            Capsules</div>
                    </div>
                </div>
            </div>
            <div class="hint-gift-select show-mobile">
                <h3 class="hint-items__title">Choose Gifts*</h3>
                <div class="hint-gift-select-item">
                    <p>Choose one or more gifts</p>
                    
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 16.5C13.1421 16.5 16.5 13.1421 16.5 9C16.5 4.85786 13.1421 1.5 9 1.5C4.85786 1.5 1.5 4.85786 1.5 9C1.5 13.1421 4.85786 16.5 9 16.5Z" stroke="#9D9D9D" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M6.35254 8.05469L9.00004 10.6947L11.6475 8.05469" stroke="#9D9D9D" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>


                <div class="hint-items-mobile">
                    <div data-product="Citrus Bergamot Capsules" class="hint-item">
                        <div class="hint-item-check"></div>
                        <div class="hint-item__img">
                            <img
                                src="{{ 'gift-item-img-1.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__text">
                            <div class="hint-item__title ">Citrus Bergamot Capsules</div>
                            <p class="hint-item__descr">(Heart health, blood sugar control, stress-free wellness)</p>
                        </div>
                        
                    </div>
                    <div data-product="Sea Moss Capsules" class="hint-item">
                        <div class="hint-item-check"></div>
                        <div class="hint-item__img">
                            <img
                                src="{{ 'gift-item-img-2.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__text">
                            <div class="hint-item__title ">Sea Moss Capsules</div>
                            <p class="hint-item__descr">(Enhanced energy, balanced thyroid, improved digestion)</p>
                        </div>
                        
                    </div>
                    <div data-product="Berberine Capsules" class="hint-item">
                        <div class="hint-item-check"></div>
                        <div class="hint-item__img">
                            <img
                                src="{{ 'gift-item-img-3.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__text">
                            <div class="hint-item__title ">Berberine Capsules</div>
                            <p class="hint-item__descr">(Overall wellness, antioxidant protection, blood sugar balance )</p>
                        </div>
                        
                    </div>
                    {% comment %} <div data-product="Shilajit + Ashwagandha Capsules" class="hint-item">
                        <div class="hint-item-check"></div>
                        <div class="hint-item__img">
                            <img
                                src="{{ 'gift-item-img-4.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__text">
                            <div class="hint-item__title ">Shilajit + Sea Moss Capsules</div>
                            <p class="hint-item__descr">(Muscle strength, improved endurance, energy boost)</p>
                        </div>
                        
                    </div> {% endcomment %}
                    <div data-product="Sea Moss + Black Seed oil Capsules" class="hint-item">
                        <div class="hint-item-check"></div>
                        <div class="hint-item__img">
                            <img
                                src="{{ 'gift-item-img-5.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__text">
                            <div class="hint-item__title ">Sea Moss + Black Seed Oil
                                Capsules</div>
                            <p class="hint-item__descr">(Thyroid & metabolism boost, hair, skin & nail health, rest & relaxation)</p>
                        </div>
                        
                    </div>
                    
                    <div data-product="Magnesium Gummies" class="hint-item">
                        <div class="hint-item-check"></div>
                        <div class="hint-item__img">
                            <img
                                src="{{ 'magnesium-gummies-img.png' | file_url }}"
                                alt="{{ shop.name }}"
                                fetchpriority="low"
                                decoding="async"
                                width="178"
                                height="245"
                                loading="lazy"
                            >
                        </div>
                        <div class="hint-item__text">
                            <div class="hint-item__title ">Magnesium Gummies</div>
                            <p class="hint-item__descr">(Muscle & Bone Health, Restful Sleep, Enhanced Energy & Recovery)</p>
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="klaviyo_messages">
                <div class="success_message" style="display:none;"></div>
                <div class="error_message" style="display:none;"></div>
            </div>
            <button class="btn-green hint-btn">Send a Hint</button>
        </form>
    </div>
</div>

<div class="thank-modal">
    <div class="thank-modal__body">
        <div class="close-thank">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 22C17.5 22 22 17.5 22 12C22 6.5 17.5 2 12 2C6.5 2 2 6.5 2 12C2 17.5 6.5 22 12 22Z" stroke="#292D32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.16998 14.8299L14.83 9.16992" stroke="#292D32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14.83 14.8299L9.16998 9.16992" stroke="#292D32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
    
        </div>
        <h2 class="hint__title hide-mobile">Thank you! Your friend will receive information about the gift you want! </h2>
        <h2 class="hint__title show-mobile thank-title">Thank you! <br><br> Your friend will receive information about the gift you want! </h2>
        <a href="/" class="btn-green hint-btn thank-modal-btn">Continue shopping</a>
        <div class="thank-modal__img">
            <img
                src="{{ 'thank-modal-img.jpg' | file_url }}"
                alt="{{ shop.name }}"
                fetchpriority="low"
                decoding="async"
                width="1019"
                height="869"
                loading="lazy"
            >
        </div>
    </div>
    
</div>
<script defer src="{{ 'hint-gift.js' | asset_url }}"></script>