                </div>
                <button id="see-more-btn" class="see-more-btn">See More</button>

            </div>
        </div>
    </div>
</section>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Функция для расчета времени с момента публикации
    function timeAgo(date) {
      const now = new Date();
      const publishedDate = new Date(date);
      const seconds = Math.floor((now - publishedDate) / 1000);
      const minutes = Math.floor(seconds / 60);
      const hours = Math.floor(minutes / 60);
      const days = Math.floor(hours / 24);
      
      if (seconds < 60) {
        return `${seconds} seconds ago`;
      } else if (minutes < 60) {
        return `${minutes} minutes ago`;
      } else if (hours < 24) {
        return `${hours} hours ago`;
      } else {
        return `${days} days ago`;
      }
    }

    // Получите все элементы с классом "timeago"
    const timeElements = document.querySelectorAll('.timeago');
    timeElements.forEach(function(element) {
      const publishedDate = element.getAttribute('data-published');
      element.textContent = timeAgo(publishedDate);
    });

    var seeMoreBtn = document.getElementById("see-more-btn");
    var hiddenItems = document.querySelectorAll(".blog-item.hidden");

    seeMoreBtn.addEventListener("click", function() {
        hiddenItems.forEach(function(item) {
            item.classList.remove("hidden");
        });
        seeMoreBtn.style.display = "none";
    });



    const filterItems = document.querySelectorAll('.blog-filter-item');
    const blogItems = document.querySelectorAll('.blog-item');
    
    filterItems.forEach(filter => {
        filter.addEventListener('click', function() {
            const filterTag = this.getAttribute('data-filter');
            
            filterItems.forEach(item => item.classList.remove('active'));
            this.classList.add('active');
            
            blogItems.forEach(item => {
                const itemTags = item.getAttribute('data-tags').split(' ');
                
                if (filterTag === 'all' || itemTags.includes(filterTag)) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        });
    });
  });
  
   

</script>
