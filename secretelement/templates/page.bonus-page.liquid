<script>
    let trigger = document.querySelector('.dropdown-type-select__trigger')
    let dropdownItems = document.querySelector('.dropdown-select-items')
    let selectItem = document.querySelectorAll('.dropdown-select-item')
    let hiddenInput = document.querySelector('[name="product"]');
    trigger.addEventListener('click', ()=>{
        trigger.classList.toggle('active')
        dropdownItems.classList.toggle('active')
    })
    selectItem.forEach(item =>{
        item.addEventListener('click', ()=>{
            trigger.classList.remove('active')
            dropdownItems.classList.remove('active')
            let text = item.querySelector('p').innerText
            trigger.querySelector('p').innerText = text
            hiddenInput.value = item.dataset.gift
        })
    })
     
</script>
<script>
  document.querySelector('#main-popup-form button').addEventListener('click', function(e) { 
      e.preventDefault();
      let k_error = document.querySelector('.klaviyo_messages .error_message');
      let email = document.querySelector('[name="email"]');
      let product = document.querySelector('[name="product"]');
      let data = new URLSearchParams();
      let modal = document.querySelector('.bonus-modal')
      data.append("g", "U3ku25");
      data.append("email", email.value);
    //   data.append("$product", product.value);
      data.append("$fields", "$product");
      data.append("$product", product.value);

      if (!validateEmail(email.value)) {
          email.style.border = "2px solid #ff0000";
          k_error.style.display = "block";
          k_error.innerHTML = "Please enter a valid email!";
      } else {
          k_error.style.display = "none";
          email.style.border = "2px solid #000";

          fetch("https://manage.kmail-lists.com/ajax/subscriptions/subscribe", {
              method: "POST",
              headers: {
                  "Content-Type": "application/x-www-form-urlencoded",
                  "Cache-Control": "no-cache"
              },
              body: data
          })
          .then(response => response.json())
          .then(response => {
              if (response.success) {
                  k_error.style.display = "none";
                  k_error.innerHTML = "";
                  modal.classList.add('show')
                  
            
              } else {
                  if (response.data.is_subscribed) {
                      k_error.style.display = "none";
                  } else {
                      k_error.style.display = "block";
                      k_error.innerHTML = response.errors[0];
                  }
              }
          });
      }
  });


  function validateEmail(email) {
      return String(email).toLowerCase().match(/^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/);
  }


</script>
<script>
    let modalBonus = document.querySelector('.bonus-modal')
    let modalClose = document.querySelector('.bonus-modal-close')
    modalClose.addEventListener('click', ()=>{
        modalBonus.classList.remove('show')
    })
    modalBonus.addEventListener('click', ()=>{
        modalBonus.classList.remove('show')
    })
</script>