<script>
    // Select the HTML5 video
    const video2 = document.querySelector("#video2");
    let muteIcon2 = document.querySelector('.mute-icon2');
    let playIcon2 = document.querySelector('.play-icon2')
    let pauseIcon2 = document.querySelector('.pause-icon2')
    let countSecond = 0;
    // Update the progress bar
    video2.addEventListener("timeupdate", () => {
        let curr = (video2.currentTime / video2.duration) * 100;
        if (video2.ended) {
            document.querySelector(".play2").style.display = "block";
        }
        document.querySelector('.inner2').style.width = `${curr}%`;
        updateRemainingTime2();
    });

    // Pause or play the video
    const playSecond = (e) => {
        countSecond++;
        // Condition when to play a video
        if (video2.paused) {
            playIcon2.style.display = 'none'
            pauseIcon2.style.display = 'block'
            video2.play();
        } else {
            if(countSecond == 1){
                muteIcon2.style.display = 'none'
                video2.muted = false;
                video2.currentTime = 0; 
                video2.play()
                playIcon2.style.display = 'none'
                pauseIcon2.style.display = 'block'
            } else{
                video2.pause();
                playIcon2.style.display = 'block'
                pauseIcon2.style.display = 'none'
            }
        }
    }

    // Rewind the current time
    const rewind2 = (e) => {
        video2.currentTime = video2.currentTime - ((video2.duration / 100) * 5);
    }

    // Update the remaining time display
    const updateRemainingTime2 = () => {
        const remainingTime = video2.duration - video2.currentTime;
        document.querySelector('.duration2').textContent = formatTime2(remainingTime);
    }

    // Format time in MM:SS
    const formatTime2 = (time) => {
        const minutes = Math.floor(time / 60);
        const seconds = Math.floor(time % 60);
        return `${minutes}:${seconds.toString().padStart(2, '0')}`;
    }

    // Add event listener to the video element for play/pause
    video2.addEventListener('click', playSecond);

    // Update the remaining time when the video is paused or played
    video2.addEventListener('play', updateRemainingTime2);
    video2.addEventListener('pause', updateRemainingTime2);
    video2.addEventListener('loadedmetadata', updateRemainingTime2);
    video2.addEventListener('timeupdate', updateRemainingTime2);

    updateRemainingTime2(); // Initialize the remaining time display

</script>
<script>
    function isFullyVisible(element) {
        const rect = element.getBoundingClientRect();
        return rect.width < window.innerWidth;
    }
    function pauseOnFullVisibility() {
        const isPartiallyVisible = (element) => {
            const rect = element.getBoundingClientRect();
            return rect.top < window.innerHeight && rect.bottom > 0;
        };
        const scrollingElements = document.querySelectorAll(".scrolling");
        scrollingElements.forEach((scrollingElement) => {
            const scrollingItem = scrollingElement.querySelector(".scrolling-items__item");
            const clonedItem = scrollingItem.cloneNode(true);
            scrollingItem.after(clonedItem);
        });
        const scrollingContainer = document.querySelectorAll(".scrolling__items");
        scrollingContainer.forEach((thisScrollingContainer) => {
            thisScrollingContainer.style.animationPlayState = "running";
        });
    }
    pauseOnFullVisibility();
    var scrollLinks = document.querySelectorAll(".scroll-btn");
    scrollLinks.forEach(function (link) {
        link.addEventListener("click", function (event) {
            event.preventDefault();
            var target = document.getElementById("land-products");
            if (target) {
                var top = target.getBoundingClientRect().top + window.pageYOffset;
                window.scrollTo({ top: top, behavior: "smooth" });
            }
        });
    });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const burger = document.querySelector('.burger');
    const mobileMenu = document.querySelector('.header__menu--mobile');

    burger.addEventListener('click', function () {
      this.classList.toggle('active');
      if (this.classList.contains('active')) {
        mobileMenu.style.height = `${mobileMenu.scrollHeight}px`
      } else {
        mobileMenu.style.height = '0px';
      }
    });
  });
</script>
<script>
    document.querySelectorAll('.accordion-header').forEach(item => {
        item.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            document.querySelectorAll('.accordion-header').forEach(header => header.classList.remove('active'));
            document.querySelectorAll('.accordion-content').forEach(content => {
                content.style.maxHeight = '0';
            });

            if (!isActive) {
                item.classList.add('active');
                const content = item.nextElementSibling;
                content.style.maxHeight = content.scrollHeight + 'px';
            }
        });
    });
</script>