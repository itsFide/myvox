<section class="hero">
    <div class="container">
        <div class="hero__inner">
            <div class="hero__text">
                <h1 class="hero__title title">THE CLEAN + CLINICAL DIFFERENCE</h1>
                <p class="hero__descr">We make supplements for people that expect more. That includes unparalleled clean standards, clinical research to demonstrate efficacy of our products and meticulous sourcing of ingredients and sustainable packaging.</p>
            </div>
            <div class="hero__img">
                <picture>
                    <source media="(max-width: 650px)" srcset="{{ 'se-science-hero-img-mobile.png' | file_url }}">
                    <source media="(max-width: 1024px)" srcset="{{ 'se-science-hero-img-tablet.png' | file_url }}">
                    <img
                        src="{{ 'se-science-hero-img.png' | file_url }}"
                        alt="{{ shop.name }}"
                        fetchpriority="low"
                        decoding="async"
                        width="973"
                        height="761"
                        loading="lazy"
                    >
                </picture>
            </div>
        </div>
    </div>
</section>
<section class="perfect">
    <div class="container">
        <div class="perfect__inner">
