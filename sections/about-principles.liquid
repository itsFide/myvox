{% render 'async-stylesheet', file: 'about-principles.css' %}
<section class="principles">
    <div class="container">
        <div class="principles__header">
            <span class="principles__label gray-badge">
                THE MYVOX-9 STANDARD
            </span>

            <h2 class="principles__title">
                Four principles. Non-negotiable
            </h2>

            <p class="principles__description">
                Every protocol follows these rules — <br class="mobile-br"> from formulation to packaging.
                <br>
                They protect potency, transparency, and long-term effectiveness.
            </p>
        </div>

        <div class="principles__list">
            <article class="principle-card">
                <div class="principle-card__icon">
                    <img src="{{ 'clinical_dosage_icon_400d6ee0-1e9f-44d3-a4db-d6994d52eb1d.svg' | file_url }}" alt="Clinical Dosage" loading="lazy"
                        aria-hidden="true">
                </div>

                <div class="principle-card__content">
                    <h3 class="principle-card__title">
                        <span>01.</span>
                        Full-Strength Dosage
                    </h3>

                    <p class="principle-card__text">
                        Ingredients appear at functional concentrations chosen
                        for biological response — not label aesthetics.
                        If the dose can't do the work, it isn't in the formula.
                    </p>
                </div>
            </article>

            <article class="principle-card">
                <div class="principle-card__icon">
                    <img src="{{ 'clean_label_icon_bcdbfc9e-7290-4449-a48d-034429b1bb88.svg' | file_url }}" alt="Clean Label" loading="lazy" aria-hidden="true">
                </div>

                <div class="principle-card__content">
                    <h3 class="principle-card__title">
                        <span>02.</span>
                        Clean Label
                    </h3>

                    <p class="principle-card__text">
                        Formulas contain active compounds only. <br>
                        Each ingredient earns its place through measurable
                        contribution to the protocol's outcome.
                    </p>
                </div>
            </article>

            <article class="principle-card">
                <div class="principle-card__icon">
                    <img src="{{ 'honest_taste_icon_13bc4c3a-44a3-4989-bcea-63fe005a9df1.svg' | file_url }}" alt="Honest Taste" loading="lazy"
                        aria-hidden="true">
                </div>

                <div class="principle-card__content">
                    <h3 class="principle-card__title">
                        <span>03.</span>
                        Honest Taste
                    </h3>

                    <p class="principle-card__text">
                        Compounds stay unmasked. Astringency signals Propolis.
                        Acidity signals live enzymes. Taste is feedback — not
                        decoration. Sweetness masks absence.
                    </p>
                </div>
            </article>

            <article class="principle-card">
                <div class="principle-card__icon">
                    <img src="{{ 'cold_preservation_icon_aa3096f3-6b4b-46f5-a7ba-61a087b7bbce.svg' | file_url }}" alt="Cold Preservation" loading="lazy"
                        aria-hidden="true">
                </div>

                <div class="principle-card__content">
                    <h3 class="principle-card__title">
                        <span>04.</span>
                        Cold Preservation
                    </h3>

                    <p class="principle-card__text">
                        Lyophilization removes moisture in a vacuum at low
                        temperature. Enzymes, fatty acids, and bioactive compounds
                        pause — they don't degrade.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>

