{% render 'async-stylesheet', file: 'complex-depletion.css' %}
<section class="depletion">
    <div class="container">

        <div class="depletion__wrapper">

            <div class="depletion__content">

                <span class="depletion__label gray-badge">
                    FROM DEPLETION TO RESERVE
                </span>

                <h2 class="depletion__title">
                    Modern depletion rarely
                    looks dramatic.
                    <br>
                    It looks like this.
                </h2>

                <p class="depletion__description">
                    Energy peaks and crashes. Focus fragments by noon.
                    Immunity reacts too late. A shelf full of supplements
                    that don't add up to much. Api-Complex changes the rhythm.
                </p>

                <blockquote class="depletion__quote">
                    <p>
                        One ritual replaces a cabinet of bottles.
                    </p>
                </blockquote>

            </div>

            <div class="depletion__comparison">

                <div class="depletion__head">

                    <h3 class="depletion__heading">
                        Before
                    </h3>

                    <h3 class="depletion__heading depletion__heading--accent">
                        After <br> Protocol One
                    </h3>

                </div>

                <div class="depletion__body">

                    <div class="depletion__row">

                        <p class="depletion__text">
                            Energy spikes then crashes by afternoon
                            <span class="depletion__arrow" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" id="icon-arrow" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M14.0479 17.6537L19.7019 11.9999L14.0479 6.34619L12.9942 7.43069L16.8134 11.2499H4.2979V12.7499H16.8134L12.9942 16.5692L14.0479 17.6537Z"
                                        fill="currentColor" />
                                </svg>
                            </span>
                        </p>



                        <p class="depletion__text">
                            Energy steadies — no debt, no crash
                        </p>

                    </div>

                    <div class="depletion__row">

                        <p class="depletion__text">
                            Immunity reacts — always catching up
                            <span class="depletion__arrow" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" id="icon-arrow" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M14.0479 17.6537L19.7019 11.9999L14.0479 6.34619L12.9942 7.43069L16.8134 11.2499H4.2979V12.7499H16.8134L12.9942 16.5692L14.0479 17.6537Z"
                                        fill="currentColor" />
                                </svg>
                            </span>
                        </p>



                        <p class="depletion__text">
                            Daily readiness before exposure hits
                        </p>

                    </div>

                    <div class="depletion__row">

                        <p class="depletion__text">
                            Focus fragments under sustained demand
                            <span class="depletion__arrow" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" id="icon-arrow" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M14.0479 17.6537L19.7019 11.9999L14.0479 6.34619L12.9942 7.43069L16.8134 11.2499H4.2979V12.7499H16.8134L12.9942 16.5692L14.0479 17.6537Z"
                                        fill="currentColor" />
                                </svg>
                            </span>
                        </p>



                        <p class="depletion__text">
                            Clarity holds through the full day
                        </p>

                    </div>

                    <div class="depletion__row">

                        <p class="depletion__text">
                            Digestion feels slow and unpredictable
                            <span class="depletion__arrow" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" id="icon-arrow" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M14.0479 17.6537L19.7019 11.9999L14.0479 6.34619L12.9942 7.43069L16.8134 11.2499H4.2979V12.7499H16.8134L12.9942 16.5692L14.0479 17.6537Z"
                                        fill="currentColor" />
                                </svg>
                            </span>
                        </p>


                        <p class="depletion__text">
                            Absorption improves, digestion lightens
                        </p>

                    </div>

                    <div class="depletion__row">

                        <p class="depletion__text">
                            Recovery lingers longer than it should
                            <span class="depletion__arrow" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" id="icon-arrow" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M14.0479 17.6537L19.7019 11.9999L14.0479 6.34619L12.9942 7.43069L16.8134 11.2499H4.2979V12.7499H16.8134L12.9942 16.5692L14.0479 17.6537Z"
                                        fill="currentColor" />
                                </svg>
                            </span>
                        </p>



                        <p class="depletion__text">
                            Recovery completes — not lingers
                        </p>

                    </div>

                    <div class="depletion__row">

                        <p class="depletion__text">
                            5–6 different bottles, zero confidence
                            <span class="depletion__arrow" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" id="icon-arrow" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M14.0479 17.6537L19.7019 11.9999L14.0479 6.34619L12.9942 7.43069L16.8134 11.2499H4.2979V12.7499H16.8134L12.9942 16.5692L14.0479 17.6537Z"
                                        fill="currentColor" />
                                </svg>
                            </span>
                        </p>



                        <p class="depletion__text">
                            One ritual. Everything covered.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>

