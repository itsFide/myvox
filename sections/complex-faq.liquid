{% render 'async-stylesheet', file: 'complex-faq.css' %}
<script src="{{ 'complex-faq.js' | asset_url }}" defer></script>
<section class="faq">
    <div class="container">

        <div class="faq__inner">

            <div class="faq__content">

                <span class="faq__label gray-badge">
                    FAQ
                </span>

                <h2 class="faq__title">
                    Questions,<br>
                    answered directly
                </h2>

            </div>

            <div class="faq__accordion">

                <div class="faq-item faq-item--active">

                    <button class="faq-item__summary" type="button" aria-expanded="true">

                        <h3 class="faq-item__question">
                            Who is this protocol for?
                        </h3>

                        <span class="faq-item__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-plus" viewBox="0 0 24 24" fill="none">
                                <path d="M11.25 12.75H5.5V11.25H11.25V5.5H12.75V11.25H18.5V12.75H12.75V18.5H11.25V12.75Z"
                                    fill="#D16F55" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-minus" viewBox="0 0 24 24" fill="none">
                                <path d="M5.5 12.75V11.25H18.5V12.75H5.5Z" fill="#D16F55" />
                            </svg>
                        </span>

                    </button>

                    <div class="faq-item__content">

                        <p>
                            Adults seeking foundational daily support for
                            energy, immunity, digestion, and recovery —
                            particularly those who have outgrown fragmented
                            supplement stacks.
                        </p>

                    </div>

                </div>

                <div class="faq-item">

                    <button class="faq-item__summary" type="button" aria-expanded="false">

                        <h3 class="faq-item__question">
                            Royal Jelly and hormones — Is there a risk?
                        </h3>

                        <span class="faq-item__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-plus" viewBox="0 0 24 24" fill="none">
                                <path d="M11.25 12.75H5.5V11.25H11.25V5.5H12.75V11.25H18.5V12.75H12.75V18.5H11.25V12.75Z"
                                    fill="#D16F55" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-minus" viewBox="0 0 24 24" fill="none">
                                <path d="M5.5 12.75V11.25H18.5V12.75H5.5Z" fill="#D16F55" />
                            </svg>
                        </span>

                    </button>

                    <div class="faq-item__content">

                        <p>
                            Royal Jelly contains phyto-compounds, not human hormones. 10-HDA is a fatty acid signaling compound. Intended for daily use on the 30-day cycle. If you have a medical condition or take medication, consult your healthcare provider first.
                        </p>

                    </div>

                </div>

                <div class="faq-item">

                    <button class="faq-item__summary" type="button" aria-expanded="false">

                        <h3 class="faq-item__question">
                            Why the 10-day break?
                        </h3>

                        <span class="faq-item__icon" aria-hidden="true">
                           <svg xmlns="http://www.w3.org/2000/svg" id="icon-plus" viewBox="0 0 24 24" fill="none">
                                <path d="M11.25 12.75H5.5V11.25H11.25V5.5H12.75V11.25H18.5V12.75H12.75V18.5H11.25V12.75Z"
                                    fill="#D16F55" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-minus" viewBox="0 0 24 24" fill="none">
                                <path d="M5.5 12.75V11.25H18.5V12.75H5.5Z" fill="#D16F55" />
                            </svg>
                        </span>

                    </button>

                    <div class="faq-item__content">

                        <p>
                            Receptor sensitivity. High-potency bioactives
                            work best when receptors stay sensitive.
                            The break is part of the dose — not a gap
                            in the protocol. Your subscription ships on
                            day 40 automatically.
                        </p>

                    </div>

                </div>

                <div class="faq-item">

                    <button class="faq-item__summary" type="button" aria-expanded="false">

                        <h3 class="faq-item__question">
                            Why no hot liquid?
                        </h3>

                        <span class="faq-item__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-plus" viewBox="0 0 24 24" fill="none">
                                <path d="M11.25 12.75H5.5V11.25H11.25V5.5H12.75V11.25H18.5V12.75H12.75V18.5H11.25V12.75Z"
                                    fill="#D16F55" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-minus" viewBox="0 0 24 24" fill="none">
                                <path d="M5.5 12.75V11.25H18.5V12.75H5.5Z" fill="#D16F55" />
                            </svg>
                        </span>

                    </button>

                    <div class="faq-item__content">

                        <p>
                            Enzymes and 10-HDA denature above
                            40°C / 104°F. Heat destroys the biological
                            activity that makes Api-Complex work.
                            Mix into cool or room-temperature foods only.
                        </p>

                    </div>

                </div>

                <div class="faq-item">

                    <button class="faq-item__summary" type="button" aria-expanded="false">

                        <h3 class="faq-item__question">
                            How is it kept fresh without refrigeration?
                        </h3>

                        <span class="faq-item__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-plus" viewBox="0 0 24 24" fill="none">
                                <path d="M11.25 12.75H5.5V11.25H11.25V5.5H12.75V11.25H18.5V12.75H12.75V18.5H11.25V12.75Z"
                                    fill="#D16F55" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-minus" viewBox="0 0 24 24" fill="none">
                                <path d="M5.5 12.75V11.25H18.5V12.75H5.5Z" fill="#D16F55" />
                            </svg>
                        </span>

                    </button>

                    <div class="faq-item__content">

                        <p>
                            Lyophilization removes moisture under vacuum
                            at low temperature — placing biological activity
                            in suspension. Hermetically sealed sticks maintain
                            stability until you open one.
                        </p>

                    </div>

                </div>

                <div class="faq-item">

                    <button class="faq-item__summary" type="button" aria-expanded="false">

                        <h3 class="faq-item__question">
                            Any contraindications?
                        </h3>

                        <span class="faq-item__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-plus" viewBox="0 0 24 24" fill="none">
                                <path d="M11.25 12.75H5.5V11.25H11.25V5.5H12.75V11.25H18.5V12.75H12.75V18.5H11.25V12.75Z"
                                    fill="#D16F55" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" id="icon-minus" viewBox="0 0 24 24" fill="none">
                                <path d="M5.5 12.75V11.25H18.5V12.75H5.5Z" fill="#D16F55" />
                            </svg>
                        </span>

                    </button>

                    <div class="faq-item__content">

                        <p>
                            Do not use if you have a known allergy to bee products, pollen, or bee stings. If you have a diagnosed medical condition or take prescription medication, consult your healthcare provider before use.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


{% schema %}
{
  "name": "Complex Faq",
  "class": "complex-faq",
  "settings": [

  ],
  "presets": [
    {
      "name": "Complex Faq"
    }
  ]
}
{% endschema %}