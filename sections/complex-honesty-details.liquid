{% render 'async-stylesheet', file: 'complex-honesty-details.css' %}
<section class="honesty-details">
    <div class="container">

        <div class="honesty-details__inner">

            <div class="honesty-details__taste">

                <h2 class="honesty-details__title">
                    What the taste tells you
                </h2>

                <dl class="honesty-details__list">

                    <div class="honesty-details__item">

                        <dt class="honesty-details__term">
                            ASTRINGENCY
                        </dt>

                        <dd class="honesty-details__description">
                            <strong>Propolis —</strong>
                            antimicrobial potency, mild numbing.
                            Signal of concentration, not flaw.
                        </dd>

                    </div>

                    <div class="honesty-details__item">

                        <dt class="honesty-details__term">
                            ACIDITY
                        </dt>

                        <dd class="honesty-details__description">
                            <strong>Bee Bread —</strong>
                            live fermentation activity.
                            Means the enzymes are intact.
                        </dd>

                    </div>

                    <div class="honesty-details__item">

                        <dt class="honesty-details__term">
                            DENSE FINISH
                        </dt>

                        <dd class="honesty-details__description">
                            <strong>Royal Jelly at a working dose —</strong>
                            not the 50mg token seen in other supplements.
                        </dd>

                    </div>

                </dl>

            </div>

            <div class="honesty-details__usage">

                <h2 class="honesty-details__title">
                    How most people take it
                </h2>

                <div class="honesty-details__cards">

                    <article class="usage-card">

                        <span class="usage-card__number">
                            01
                        </span>

                        <div class="usage-card__content">

                            <h3 class="usage-card__title">
                                The Gourmet
                            </h3>

                            <p class="usage-card__text">
                                Mix into yogurt, cold smoothie, or honey.
                                <br>
                                Fat improves absorption of propolis and
                                fat-soluble compounds.
                            </p>

                        </div>

                    </article>

                    <article class="usage-card">

                        <span class="usage-card__number">
                            02
                        </span>

                        <div class="usage-card__content">

                            <h3 class="usage-card__title">
                                The Biohacker
                            </h3>

                            <p class="usage-card__text">
                                Hold under the tongue 2–3 minutes before swallowing.
                                <br>
                                Bypasses digestion for maximum Royal Jelly uptake.
                            </p>

                        </div>

                    </article>

