                        <div class="usage-warning__content">

                            <h3 class="usage-warning__title">
                                Never above 40°C / 104°F —
                            </h3>

                            <p class="usage-warning__text">
                                heat destroys enzyme activity. <br>
                                No hot tea, coffee, or warm liquid.
                            </p>

