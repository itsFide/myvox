<script>
    document.addEventListener('DOMContentLoaded', function () {

  const BREAKPOINTS = {
    MOBILE: 393,
    DESKTOP: 1476,
  };


  function getCurrentMode() {
    return window.innerWidth <= 650 ? BREAKPOINTS.MOBILE : BREAKPOINTS.DESKTOP;
  }

  function getResponsiveValue(px, baseWidth = 393) {
    const scale = window.innerWidth / baseWidth;
    return px * scale;
  }

  const thumbnailSliderHero = new Swiper('.hero__thumbnails', {
    slidesPerView: 3.763,
    freeMode: true,
    on: {
      init: function () {

        if (window.innerWidth < 651) {
          setTimeout(() => {
            const position = -(getResponsiveValue(65));
            this.setTranslate(position);


          }, 100);
        }

      },
    },
    breakpoints: {
      // When window width is >= 640px
      0: {
        slidesPerView: 3,
        spaceBetween: getResponsiveValue(6),
      },

      651: {
        slidesPerView: 3.763,
      }
    }
  });

  new Swiper('.hero__image', {
    thumbs: {
      swiper: thumbnailSliderHero,
    },
  });

  window.addEventListener('resize', () => {
    let resizeTimer;

    if (resizeTimer) {
      clearTimeout(resizeTimer);
    }

    resizeTimer = setTimeout(() => {
      if (window.innerWidth <= 650) {
        thumbnailSliderHero.params.spaceBetween = getResponsiveValue(6);
      }
      thumbnailSliderHero.update();
    }, 100);
  });


  const purchaseCards = document.querySelectorAll('.hero__purchase .purchase-card');
  const purchaseInputs = document.querySelectorAll('.hero__purchase .purchase-card__input');

  purchaseInputs.forEach(function (input) {
    input.addEventListener('change', function () {
      purchaseCards.forEach(function (card) {
        const cardInput = card.querySelector('.purchase-card__input');
        if (cardInput && cardInput.checked) {
          card.classList.add('purchase-card--active');
        } else {
          card.classList.remove('purchase-card--active');
        }
      });
    });
  });

  purchaseCards.forEach(function (card) {
    card.addEventListener('click', function (e) {
      if (e.target.closest('.purchase-card__input') || e.target.closest('label[for]')) {
        return;
      }
      const input = card.querySelector('.purchase-card__input');
      if (input && !input.checked) {
        input.checked = true;
        input.dispatchEvent(new Event('change'));
      }
    });
  });

  // Reviews slider with tab filtering, counter, and progress bar
  const reviewsSection = document.querySelector('.reviews');
  const tabs = reviewsSection.querySelectorAll('.reviews__category');
  const slides = reviewsSection.querySelectorAll('.swiper-slide');
  const counterTotal = reviewsSection.querySelector('.reviews__counter');
  const progressBar = reviewsSection.querySelector('.reviews__progress-bar span');

  let activeCategory = 'energy';
  let currentVisibleIndex = 0;
  let prevSwiperIndex = 0;

  const reviewsSwiper = new Swiper('.reviews__list', {
    slidesPerView: 1,
    navigation: {
      nextEl: '.reviews__button--next',
      prevEl: '.reviews__button--prev',
    },
    on: {
      slideChange: function () {
        var visible = getVisibleSlides();
        if (this.activeIndex > prevSwiperIndex) {
          currentVisibleIndex = Math.min(currentVisibleIndex + 1, visible.length - 1);
        } else if (this.activeIndex < prevSwiperIndex) {
          currentVisibleIndex = Math.max(currentVisibleIndex - 1, 0);
        }
        prevSwiperIndex = this.activeIndex;
        updateCounter();
      },
    },
  });

  function getVisibleSlides() {
    return Array.from(slides).filter(function (slide) {
      return slide.dataset.category === activeCategory;
    });
  }

  function countReviews(slideList) {
    return slideList.reduce(function (sum, slide) {
      return sum + slide.querySelectorAll('.review-card').length;
    }, 0);
  }

  function updateCounter() {
    const visible = getVisibleSlides();
    const total = countReviews(visible);

    let current = 0;
    for (let i = 0; i <= currentVisibleIndex; i++) {
      current += visible[i].querySelectorAll('.review-card').length;
    }

    counterTotal.innerHTML = '<strong>' + current + '</strong> / ' + total;

    const percent = total > 0 ? (current / total) * 100 : 0;
    progressBar.style.width = percent + '%';
  }

  function filterByCategory(category) {
    activeCategory = category;
    currentVisibleIndex = 0;
    prevSwiperIndex = 0;

    slides.forEach(function (slide) {
      if (slide.dataset.category === category) {
        slide.style.display = '';
      } else {
        slide.style.display = 'none';
      }
    });

    reviewsSwiper.update();
    reviewsSwiper.slideTo(0, 0);
    updateCounter();
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) {
        t.classList.remove('reviews__category--active');
      });
      this.classList.add('reviews__category--active');

      const category = this.textContent.trim().toLowerCase();
      filterByCategory(category);
    });
  });

  filterByCategory(activeCategory);

  // FAQ accordion
  const faqItems = document.querySelectorAll('.faq-item');

  function closeItem(item) {
    var content = item.querySelector('.faq-item__content');
    content.style.maxHeight = content.scrollHeight + 'px';
    content.offsetHeight;
    content.style.maxHeight = '0';
    item.classList.remove('faq-item--active');
    item.querySelector('.faq-item__summary').setAttribute('aria-expanded', 'false');
  }

  function openItem(item) {
    var content = item.querySelector('.faq-item__content');
    item.classList.add('faq-item--active');
    item.querySelector('.faq-item__summary').setAttribute('aria-expanded', 'true');
    content.style.maxHeight = content.scrollHeight + 'px';
  }

  faqItems.forEach(function (item) {
    var btn = item.querySelector('.faq-item__summary');
    btn.addEventListener('click', function () {
      if (item.classList.contains('faq-item--active')) {
        closeItem(item);
      } else {
        openItem(item);
      }
    });
  });

  faqItems.forEach(function (item) {
    var content = item.querySelector('.faq-item__content');
    if (item.classList.contains('faq-item--active')) {
      content.style.maxHeight = content.scrollHeight + 'px';
    } else {
      content.style.maxHeight = '0';
    }
  });
});

</script>
