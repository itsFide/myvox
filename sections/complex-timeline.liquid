{% render 'async-stylesheet', file: 'complex-timeline.css' %}
<section class="timeline">
            <div class="timeline__image">
                <picture>
                    <source srcset="{{ 'a-real-timeline-bg.avif' |  asset_url }}" type="image/avif">
                    <img src="{{ 'a-real-timeline-bg.webp' |  file_url }}" alt="A real timeline background" loading="lazy" decoding="async" fetchpriority="low">
                </picture>
            </div>
            <div class="container">

                <div class="timeline__inner">

                    <div class="timeline__header">

                        <div class="timeline__content">

                            <span class="timeline__label ts-badge">
                                A Real Timeline
                            </span>

                            <h2 class="timeline__title">
                                Biology responds in stages<br>
                                Repetition lays the track
                            </h2>

                        </div>

                        <div class="timeline__description">

                            <p>
                                Api-Complex works through rhythm, not shock.
                                The first day isn't the result — the 30th day is.
                                Here's what most consistent users report.
                            </p>

                        </div>

                    </div>

                    <div class="timeline__cards">

                        <article class="timeline-card">

                            <span class="timeline-card__period ts-badge">
                                Days 1–3
                            </span>

                            <h3 class="timeline-card__title">
                                Signal<br>
                                goes out
                            </h3>

                            <p class="timeline-card__text">
                                Awareness of the compounds begins.
                                The biological system wakes up and starts reading the
                                input. Some users notice a mild warmth or heightened
                                clarity.
                            </p>

                        </article>

                        <article class="timeline-card">

                            <span class="timeline-card__period ts-badge">
                                Around Day 7
                            </span>

                            <h3 class="timeline-card__title">
                                Pattern<br>
                                becomes visible
                            </h3>

                            <p class="timeline-card__text">
                                Energy stretches across the full day.
                                <br>
                                Digestion lightens. The protocol stops feeling like
                                an addition and starts feeling like a rhythm.
                            </p>

                        </article>

                        <article class="timeline-card">

                            <span class="timeline-card__period ts-badge">
                                Around Day 30
                            </span>

                            <h3 class="timeline-card__title timeline-card__title--accent">
                                Capacity<br>
                                returns
                            </h3>

                            <p class="timeline-card__text">
                                The protocol disappears into function.
                                <br>
                                Reserve is back. The body responds to sustained
                                demand without the cost it used to charge.
                            </p>

                        </article>

                    </div>

                    <div class="timeline__footer">

                        <p class="timeline__note">
                            * Individual results vary. These represent common patterns
                            reported by consistent users across the 30-day course.
                        </p>

                    </div>

                </div>

            </div>
        </section>


{% schema %}
{
  "name": "Complex Timeline",
  "class": "complex-timeline",
  "settings": [

  ],
  "presets": [
    {
      "name": "Complex Timeline"
    }
  ]
}
{% endschema %}