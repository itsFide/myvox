{% render 'async-stylesheet', file: 'faq-cta.css' %}
<section class="cta">
    <div class="cta__image">
        <picture>
            <source media="(max-width: 650px)" srcset="{{ 'cta-bg-mobile.avif' | file_url }}" type="image/avif">
            <source media="(max-width: 650px)" srcset="{{ 'cta-bg-mobile.webp' | file_url }}" type="image/webp">
            <source srcset="{{ 'cta-bg_cb399b96-50c0-438e-94b0-51001e53511f.avif' | file_url }}" type="image/avif">
            <img src="{{ 'cta-bg_922c5c1b-f3cc-4455-bc78-12c0458d9573.webp' | file_url }}" alt="Api-Complex rewards informed use
                        Start deliberately." fetchpriority="low" loading="lazy" decoding="async">
        </picture>
    </div>
    <div class="container">

        <div class="cta__content">

            <span class="cta__label ts-badge">
                FROM HERE
            </span>

            <h2 class="cta__title">
                Api-Complex rewards informed use <br class="mobile-br">
                Start deliberately.
                <br>
                <span>Cycle intentionally</span>
            </h2>

            <div class="cta__text">
                <p>
                    This is how biological tools perform at their best. <br>
                    You now have the full picture.
                </p>

                <p>
                    The protocol is ready when you are.
                </p>
            </div>

            <div class="cta__actions">
                <a class="button button--primary" href="/products/api-complex-by-myvox-9">
                    Explore Api-Complex

                   
<svg id="arrow" viewBox="0 0 24 24" fill="currentColor"
    xmlns="http://www.w3.org/2000/svg">
    <path d="M6.34582 9.95185L11.9996 4.29785L17.6533 9.95185L16.5688 11.0056L12.7496 7.18635L12.7496 19.7019L11.2496 19.7019L11.2496 7.18635L7.43032 11.0056L6.34582 9.95185Z" fill="currentColor"/>
</svg>

                </a>

                <a class="button button--secondary" href="/pages/science">
                    Read the Science

                    
<svg id="arrow" viewBox="0 0 24 24" fill="currentColor"
    xmlns="http://www.w3.org/2000/svg">
    <path d="M6.34582 9.95185L11.9996 4.29785L17.6533 9.95185L16.5688 11.0056L12.7496 7.18635L12.7496 19.7019L11.2496 19.7019L11.2496 7.18635L7.43032 11.0056L6.34582 9.95185Z" fill="currentColor"/>
</svg>

                </a>
            </div>

        </div>

    </div>
</section>

