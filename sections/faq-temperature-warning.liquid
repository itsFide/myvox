{% render 'async-stylesheet', file: 'faq-temperature.css' %}
<section class="temperature-warning">
    <div class="temperature-warning__image">
        <picture>
            <source media="(max-width: 650px)" srcset="{{ 'temperature-warning-mobile-bg.avif' | file_url }}"
                type="image/avif">
            <source media="(max-width: 650px)" srcset="{{ 'temperature-warning-mobile-bg.webp' | file_url }}"
                type="image/webp">
            <source srcset="{{ 'temperature-warning-bg.avif' | file_url }}" type="image/avif">
            <img src="{{ 'temperature-warning-bg.webp' | file_url }}" alt="Respect the Enzymes" fetchpriority="low"
                loading="lazy" decoding="async">
        </picture>
    </div>
    <div class="container">
        <article class="temperature-warning__card">

            <div class="temperature-warning__aside">

                <div class="temperature-warning__temperature">
                    <div class="temperature-warning__icon">

                        <svg id="heat-icon" viewBox="0 0 48 48" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
