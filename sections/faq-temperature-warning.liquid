                            <path d="M17.6667 29.3465H14V27.4522H17.6667V29.3465Z" fill="currentColor" />
                            <path d="M36 29.3465H32.3333V27.4522H36V29.3465Z" fill="currentColor" />
                            <path d="M17.6667 24.2147H15.467V22.3203H17.6667V24.2147Z" fill="currentColor" />
                            <path d="M34.533 24.2147H32.3333V22.3203H34.533V24.2147Z" fill="currentColor" />
                            <path d="M17.6667 19.8136H14V17.9192H17.6667V19.8136Z" fill="currentColor" />
                            <path d="M36 19.8136H32.3333V17.9192H36V19.8136Z" fill="currentColor" />
                            <path d="M17.6667 14.6799H15.467V12.7855H17.6667V14.6799Z" fill="currentColor" />
                            <path d="M34.533 14.6799H32.3333V12.7855H34.533V14.6799Z" fill="currentColor" />
                            <path d="M17.6667 9.54803H14V7.65365H17.6667V9.54803Z" fill="currentColor16F55" />
                            <path d="M36 9.54803H32.3333V7.65365H36V9.54803Z" fill="currentColor" />
                        </svg>

                    </div>

                    40°C
                </div>

                <div class="temperature-warning__limit">
                    104°F — MAX TEMP
                </div>

            </div>

            <div class="temperature-warning__content">

                <h2 class="temperature-warning__title">
                    Respect the Enzymes
                </h2>

                <p class="temperature-warning__text">
                    Api-Complex contains live bioactive compounds. Heat above 40°C destroys them. <br>

                </p>
                <p class="temperature-warning__text">
                    Never add this to hot tea, coffee, or any warm liquid.
                    The protocol only works if the biology survives it.
                </p>

            </div>

        </article>
    </div>
</section>
