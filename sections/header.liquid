<style>
  .header{
  background: var(--blue);
}

/* ============================================
   DUAL HEADER: статичный держит место,
   sticky появляется при скролле вверх
   ============================================ */

/* Статичный хэдер: когда проскроллено вниз —
   становится невидимым, но место держит */
.header.header--scrolled-away {
  visibility: hidden;
}

/* Sticky-шапка (клон, вставляется JS'ом) */
.header-sticky {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: var(--blue);
  /* height: auto — определяется контентом, как и статичный хэдер */
  transform: translateY(-100%);
  transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              opacity 0.35s ease;
  opacity: 0;
  /* Важно: pointer-events выключены пока скрыта */
  pointer-events: none;
}

/* Видимое состояние sticky-шапки */
.header-sticky.header-sticky--visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

/* Не показываем sticky на лендинге */
body.template-landing-v1 .header-sticky {
  display: none !important;
}
body.template-landing-v1 .header.header--scrolled-away {
  visibility: visible !important;
}

body.template-landing-v1-1 .header-sticky {
  display: none !important;
}
body.template-landing-v1-1 .header.header--scrolled-away {
  visibility: visible !important;
}
@media screen and (max-width: 650px) {
  .header-sticky {
    /* height auto by content */
  }
}
</style>
