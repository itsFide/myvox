<script>
  document.addEventListener('DOMContentLoaded', function() {
    const burger = document.querySelector('.header .burger');
    const mobileMenu = document.getElementById('MobileMenu');
    const mobileMenuClose = document.getElementById('MobileMenuClose');
    
    if (burger && mobileMenu) {
      burger.addEventListener('click', function() {
        mobileMenu.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      });
    }
    
    if (mobileMenuClose && mobileMenu) {
      mobileMenuClose.addEventListener('click', function() {
        mobileMenu.classList.remove('is-active');
        document.body.style.overflow = '';
      });
    }
    
    // Accordion inside mobile menu
    const dropdownTitles = document.querySelectorAll('.header-mobile-menu__title');
    dropdownTitles.forEach(title => {
      title.addEventListener('click', function() {
        const parent = this.closest('.header-mobile-menu__item');
        if (parent) {
          parent.classList.toggle('is-open');
        }
      });
    });

    // ============================================
    // DUAL HEADER: sticky clone logic
    // Не применяем на лендинге
    // ============================================
    if (document.body.classList.contains('template-landing-v1') || document.body.classList.contains('template-landing-v1-1')) return;

    const staticHeader = document.querySelector('.header');
    if (!staticHeader) return;

    // 1. Клонируем оригинальный хэдер
    const stickyHeader = staticHeader.cloneNode(true);
    stickyHeader.classList.remove('header');
    stickyHeader.classList.add('header-sticky');
    // Меняем ID бургера в клоне, чтобы не дублировались
    const stickyBurger = stickyHeader.querySelector('.burger');

    // Вставляем sticky-шапку сразу после оригинала
    staticHeader.parentNode.insertBefore(stickyHeader, staticHeader.nextSibling);

    // 2. Подключаем мобильное меню к бургеру в sticky-шапке
    //    Используем то же самое мобильное меню (оно одно)
    if (stickyBurger && mobileMenu) {
      stickyBurger.addEventListener('click', function() {
        mobileMenu.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      });
    }

    // 3. Логика скролла
    const SCROLL_THRESHOLD = 100; // px вверх до появления sticky
    const HIDE_AFTER = 80;        // px от верха — показываем статичный

    let lastScrollY = window.scrollY;
    let scrollUpAccum = 0;
    let ticking = false;
    let stickyVisible = false;

    function showSticky() {
      if (stickyVisible) return;
      stickyVisible = true;
      stickyHeader.classList.add('header-sticky--visible');
    }

    function hideSticky() {
      if (!stickyVisible) return;
      stickyVisible = false;
      stickyHeader.classList.remove('header-sticky--visible');
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function() {
        const currentY = window.scrollY;
        const delta = lastScrollY - currentY; // > 0 = скролл вверх

        if (currentY <= HIDE_AFTER) {
          // У самого верха: статичный видим, sticky прячем
          staticHeader.classList.remove('header--scrolled-away');
          hideSticky();
          scrollUpAccum = 0;
        } else {
          // Проскроллено вниз: статичный скрываем (но место держит)
          staticHeader.classList.add('header--scrolled-away');

          if (delta > 0) {
            // Скролл вверх — накапливаем
            scrollUpAccum += delta;
            if (scrollUpAccum >= SCROLL_THRESHOLD) {
              showSticky();
            }
          } else if (delta < 0) {
            // Скролл вниз — прячем sticky, сбрасываем счётчик
            scrollUpAccum = 0;
            hideSticky();
          }
        }

        lastScrollY = currentY;
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
  });

  // ============================================
  // REAL-TIME CART COUNT BADGE LOGIC
  // ============================================
  (function() {
    function updateAllCartBadges(count) {
      const numCount = parseInt(count, 10) || 0;
      const badges = document.querySelectorAll('.cart-count-badge');
      badges.forEach(badge => {
        badge.setAttribute('data-cart-count', numCount);
        badge.textContent = numCount > 99 ? '99+' : numCount;
        if (numCount > 0) {
          badge.classList.remove('is-hidden');
        } else {
          badge.classList.add('is-hidden');
        }
        badge.classList.remove('badge-updated');
        void badge.offsetWidth;
        badge.classList.add('badge-updated');
        setTimeout(() => badge.classList.remove('badge-updated'), 300);
      });
    }

    async function refreshCartCount() {
      try {
        const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        const res = await fetch(root + 'cart.js', { cache: 'no-store' });
        if (res.ok) {
          const cart = await res.json();
          updateAllCartBadges(cart.item_count);
        }
      } catch (e) {
        console.error('Failed to fetch cart count:', e);
      }
    }

    // Standard Shopify Cart update events
    document.addEventListener('shopify:cart:lines-update', function(event) {
      if (event.detail && typeof event.detail.itemCount === 'number') {
        updateAllCartBadges(event.detail.itemCount);
      } else if (event.promise) {
        event.promise.then(function(result) {
          const count = result?.cart?.total_quantity ?? result?.cart?.item_count ?? result?.detail?.itemCount;
          if (typeof count === 'number') {
            updateAllCartBadges(count);
          } else {
            refreshCartCount();
          }
        }).catch(refreshCartCount);
      } else {
        refreshCartCount();
      }
    });

    // Intercept fetch calls to cart APIs
    const origFetch = window.fetch;
    window.fetch = function() {
      const url = arguments[0];
      const urlStr = typeof url === 'string' ? url : (url && url.url) || '';
      const isCart = /\/cart\/(add|change|update|clear)/.test(urlStr);

      return origFetch.apply(this, arguments).then(function(res) {
        if (isCart && res.ok) {
          res.clone().json().then(function(data) {
            if (typeof data.item_count === 'number') {
              updateAllCartBadges(data.item_count);
            } else {
              refreshCartCount();
            }
          }).catch(refreshCartCount);
        }
        return res;
      });
    };

    // Intercept XHR calls to cart APIs
    const origXHRSend = XMLHttpRequest.prototype.send;
    const origXHROpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function(method, url) {
      this._cartUrl = url;
      return origXHROpen.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function() {
      this.addEventListener('load', function() {
        if (this._cartUrl && /\/cart\/(add|change|update|clear)/.test(this._cartUrl)) {
          refreshCartCount();
        }
      });
      return origXHRSend.apply(this, arguments);
    };

    window.addEventListener('pageshow', function(e) {
      if (e.persisted) {
        refreshCartCount();
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', refreshCartCount);
    } else {
      refreshCartCount();
    }
  })();
</script>


