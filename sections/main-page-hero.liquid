{% comment %} 
    <div class="container hero__controls-container">
        <div class="hero__pagination" id="hero-pagination-{{ section.id }}">
            <div class="hero__pagination-fraction">
                <span class="hero__pagination-current" id="hero-current-{{ section.id }}">1</span>
                <span class="hero__pagination-separator">/</span>
                <span class="hero__pagination-total" id="hero-total-{{ section.id }}">
                    3
                </span>
            </div>
            <div class="hero__pagination-progress">
                <span class="hero__pagination-progress-bar" id="hero-progress-bar-{{ section.id }}"></span>
            </div>
        </div>
    </div> {% endcomment %}
</section>
<script>
(function () {
    const root = document.documentElement;

    let savedViewportWidth = window.innerWidth;
    let resizeFrame = 0;

    function getVisibleViewportHeight() {
        if (
            window.visualViewport &&
            Number.isFinite(window.visualViewport.height)
        ) {
            return window.visualViewport.height;
        }

        return window.innerHeight;
    }

    function lockHeroViewportHeight() {
        const viewportHeight = Math.round(getVisibleViewportHeight());

        savedViewportWidth = window.innerWidth;

        root.style.setProperty(
            '--hero-stable-viewport-height',
            viewportHeight + 'px'
        );
    }

    function handleResize() {
        cancelAnimationFrame(resizeFrame);

        resizeFrame = requestAnimationFrame(function () {
            const currentWidth = window.innerWidth;
            const widthDifference = Math.abs(
                currentWidth - savedViewportWidth
            );

            /*
             * Появление панелей браузера обычно изменяет только высоту.
             * Поэтому на такие resize-события не реагируем.
             *
             * Пересчитываем высоту только при реальном изменении ширины:
             * поворот устройства, split-screen и изменение размера окна.
             */
            if (widthDifference > 32) {
                lockHeroViewportHeight();
            }
        });
    }

    lockHeroViewportHeight();

    window.addEventListener('pageshow', lockHeroViewportHeight);

    window.addEventListener(
        'resize',
        handleResize,
        { passive: true }
    );

    window.addEventListener('orientationchange', function () {
        window.setTimeout(lockHeroViewportHeight, 300);
    });
})();
</script>
<script>
    
    (function() {
        let heroSwiper = null;

        function initSlider() {
            const sliderEl = document.querySelector('#hero-slider-{{ section.id }}');
            if (!sliderEl) return;

            if (heroSwiper && typeof heroSwiper.destroy === 'function') {
                heroSwiper.destroy(true, true);
            }

            const totalSlides = parseInt(document.querySelector('#hero-total-{{ section.id }}')?.textContent || '1', 10);
            const isLoop = totalSlides > 1;

            const swiperOptions = {
                loop: isLoop,
                slidesPerView: 1,
                spaceBetween: 0,
                effect: 'fade',
                fadeEffect: {
                    crossFade: true
                },
                on: {
                    init: function() {
                        updatePagination(this);
                    },
                    slideChange: function() {
                        updatePagination(this);
                    }
                }
            };

            if ({{ section.settings.autoplay | json }} && isLoop) {
                swiperOptions.autoplay = {
                    delay: {{ section.settings.autoplay_speed | times: 1000 | json }},
                    disableOnInteraction: false
                };
            }

            heroSwiper = new Swiper(sliderEl, swiperOptions);
        }

        function updatePagination(swiper) {
            const currentEl = document.querySelector('#hero-current-{{ section.id }}');
            const progressBarEl = document.querySelector('#hero-progress-bar-{{ section.id }}');
            if (!currentEl || !progressBarEl) return;

            const current = swiper.realIndex + 1;
            const total = swiper.slides.length - (swiper.loopedSlides ? swiper.loopedSlides * 2 : 0);
            const displayTotal = total > 0 ? total : parseInt(document.querySelector('#hero-total-{{ section.id }}')?.textContent || '1', 10);

            currentEl.textContent = current;
            progressBarEl.style.width = ((current) / displayTotal) * 100 + '%';
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSlider);
        } else {
            initSlider();
        }

        document.addEventListener('shopify:section:load', function(event) {
            if (event.detail.sectionId === '{{ section.id }}') {
                initSlider();
            }
        });
    })();
</script>

{% schema %}
{
  "name": "Hero",
  "class": "hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}