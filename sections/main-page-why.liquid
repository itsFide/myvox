      "id": "callout3_lbl",
      "label": "Callout 3 (Bottom Left) Label",
      "default": "fillers or sugar"
    },
    {
      "type": "text",
      "id": "callout4_val",
      "label": "Callout 4 (Bottom Right) Value",
      "default": "1 stick"
    },
    {
