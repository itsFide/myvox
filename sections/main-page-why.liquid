{% render 'async-stylesheet', file: 'main-page-why.css' %}

{%- liquid
  assign why_bg_desktop_avif = section.settings.bg_image
  assign why_bg_desktop_webp = section.settings.bg_image

  if why_bg_desktop_avif == blank
    assign why_bg_desktop_avif = images['why-bg.avif']
  endif
  if why_bg_desktop_avif == blank
    assign why_bg_desktop_avif = images['why-bg.webp']
  endif

  if why_bg_desktop_webp == blank
    assign why_bg_desktop_webp = images['why-bg.webp']
  endif

  assign why_bg_mobile_avif = section.settings.bg_image_mobile
  assign why_bg_mobile_webp = section.settings.bg_image_mobile

  if why_bg_mobile_avif == blank
    assign why_bg_mobile_avif = images['why-bg-mob.avif']
  endif
  if why_bg_mobile_avif == blank
    assign why_bg_mobile_avif = images['why-bg-mob.webp']
  endif

  if why_bg_mobile_webp == blank
    assign why_bg_mobile_webp = images['why-bg-mob.webp']
  endif

  assign why_main_desktop = section.settings.image

  if why_main_desktop == blank
    assign why_main_desktop = images['why-img-2.webp']
  endif

  assign why_main_mobile = section.settings.image_mobile

  if why_main_mobile == blank
    assign why_main_mobile = why_main_desktop
  endif

  assign why_main_alt = why_main_desktop.alt | default: section.settings.title | strip_html
-%}

<section class="why-section" id="why-section-{{ section.id }}">

  {%- if why_bg_desktop_avif != blank or why_bg_desktop_webp != blank -%}
    <picture class="why-section__background" aria-hidden="true">

      {%- if why_bg_mobile_avif != blank or why_bg_mobile_webp != blank -%}
        <!-- Mobile AVIF -->
        <source
          media="(max-width: 650px)"
          type="image/avif"
          srcset="
            {{ why_bg_mobile_avif | image_url: width: 390, format: 'avif' }} 390w,
            {{ why_bg_mobile_avif | image_url: width: 500, format: 'avif' }} 500w,
            {{ why_bg_mobile_avif | image_url: width: 650, format: 'avif' }} 650w,
            {{ why_bg_mobile_avif | image_url: width: 900, format: 'avif' }} 900w
          "
          sizes="100vw"
        >
        <!-- Mobile WebP (Fallback) -->
        <source
          media="(max-width: 650px)"
          type="image/webp"
          srcset="
            {{ why_bg_mobile_webp | image_url: width: 390, format: 'webp' }} 390w,
            {{ why_bg_mobile_webp | image_url: width: 500, format: 'webp' }} 500w,
            {{ why_bg_mobile_webp | image_url: width: 650, format: 'webp' }} 650w,
            {{ why_bg_mobile_webp | image_url: width: 900, format: 'webp' }} 900w
          "
          sizes="100vw"
        >
      {%- endif -%}

      <!-- Desktop AVIF -->
      <source
        type="image/avif"
        srcset="
          {{ why_bg_desktop_avif | image_url: width: 768, format: 'avif' }} 768w,
          {{ why_bg_desktop_avif | image_url: width: 1200, format: 'avif' }} 1200w,
          {{ why_bg_desktop_avif | image_url: width: 1600, format: 'avif' }} 1600w,
          {{ why_bg_desktop_avif | image_url: width: 1920, format: 'avif' }} 1920w,
          {{ why_bg_desktop_avif | image_url: width: 2560, format: 'avif' }} 2560w
        "
        sizes="100vw"
      >
      <!-- Desktop WebP (Fallback) -->
      <source
        type="image/webp"
        srcset="
          {{ why_bg_desktop_webp | image_url: width: 768, format: 'webp' }} 768w,
          {{ why_bg_desktop_webp | image_url: width: 1200, format: 'webp' }} 1200w,
          {{ why_bg_desktop_webp | image_url: width: 1600, format: 'webp' }} 1600w,
          {{ why_bg_desktop_webp | image_url: width: 1920, format: 'webp' }} 1920w,
          {{ why_bg_desktop_webp | image_url: width: 2560, format: 'webp' }} 2560w
        "
        sizes="100vw"
      >

      {%- assign fallback_img = why_bg_desktop_webp | default: why_bg_desktop_avif -%}
      <img
        src="{{ fallback_img | image_url: width: 1600, format: 'webp' }}"
        width="{{ fallback_img.width }}"
        height="{{ fallback_img.height }}"
        alt=""
        loading="lazy"
        decoding="async"
        fetchpriority="low"
      >
    </picture>
  {%- endif -%}
<div class="container">
        <div class="why__inner">
            <div class="why-section__text-col">
            {%- if section.settings.badge != blank -%}
            <div class="why-section__badge">{{ section.settings.badge | escape }}</div>
            {%- endif -%}

            {%- if section.settings.title != blank -%}
            <h2 class="why-section__title title-main">{{ section.settings.title | newline_to_br }}</h2>
            {%- endif -%}

            <div class="why-section__desc hide-mobile">
                <p>The supplement industry replaced concentration with convenience, <br>and function with flavor. Most products on market are diluted, sweetened, and dosed for label optics — not biological effect.<br><br>MYVOX-9 starts from a different premise: the body already knows how to regulate energy, stay resilient, and recover. The missing piece is input quality.</p>
            </div>
            <div class="why-section__desc show-mobile">
                <p>The supplement industry replaced concentration with convenience, and function with flavor. <br>
Most products on market are diluted, sweetened, <br>
and dosed for label optics — not biological effect.
<br><br>
MYVOX-9 starts from a different premise: the body already knows how to regulate energy, stay resilient, and recover. 
The missing piece is input quality. </p>
            </div>

            {%- if section.settings.btn_label != blank -%}
