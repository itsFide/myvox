        </picture>
    </div>

    <div class="container">
        <div class="fermetation__inner">
            <div class="fermetation-left">

                <div class="fermetation-left__bg">
                    <picture>

                        <source media="(max-width: 651px)" srcset="{{ 'fermetation-left-bg.avif' | file_url }}"
                            type="image/avif">


                        <source srcset="{{ 'fermetation-left-bg.avif' | file_url }}" type="image/avif">


