body.bonus-modal-open {
  overflow: hidden;
}

.bonus-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: none;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  align-items: center;
  z-index: 100;
  justify-content: center;
}
.bonus-modal--open {
  opacity: 1;
  display: flex;
  visibility: visible;
  pointer-events: auto;
}
.bonus-modal__overlay {
  position: absolute;
  inset: 0;
  z-index: 10;
  background-color: var(--black-80);
}
.bonus-modal__close {
  position: absolute;
  top: 0;
  right: 0;
  background: none;
  border: none;
  height: 40px;
  width: 40px;
}
.bonus-modal__close svg {
  height: 40px;
  width: 40px;
}
.bonus-modal__title {
  font-weight: 600;
  font-size: 28px;
  line-height: 120%;
  letter-spacing: 0.2px;
  margin-bottom: 16px;
}
.bonus-modal__title span {
  font-weight: inherit;
  letter-spacing: 0.4px;
  color: var(--red-100);
}
.bonus-modal__grid {
  display: grid;
  gap: 12px;
  margin-bottom: 12px;
  grid-template-columns: repeat(2, 1fr);
}
.bonus-modal .bonus-guide {
  display: flex;
  height: 200px;
  background: var(--white-50);
  border: 1px solid var(--white-20);
  box-shadow: 0px 4px 12px var(--black-20);
  backdrop-filter: blur(4px);
  border-radius: 8px;
  align-items: center;
}
.bonus-modal .bonus-guide__content {
  padding: 24px;
}
.bonus-modal .bonus-guide__price {
  display: flex;
  align-items: center;
  gap: 6px;
}
.bonus-modal .bonus-guide__price-old {
  font-size: 16px;
  letter-spacing: 0.2px;
  line-height: 120%;
  color: var(--black-100);
  font-weight: 700;
  position: relative;
}
.bonus-modal .bonus-guide__price-old:before {
  content: "";
  border-radius: 2px;
  width: 110%;
  height: 2px;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background-color: var(--red-100);
}
.bonus-modal .bonus-guide__price-free {
  font-size: 14px;
  color: var(--red-100);
  letter-spacing: 0.2px;
  font-weight: 700;
  text-transform: uppercase;
}
.bonus-modal .bonus-guide__title {
  font-size: 16px;
  letter-spacing: 0.2px;
  line-height: 120%;
  color: var(--red-100);
  font-weight: 700;
  margin-bottom: 6px;
}
.bonus-modal .bonus-guide__description {
  font-size: 14px;
  color: var(--black-50);
  margin-bottom: 6px;
}
.bonus-modal .bonus-guide__image {
  flex-shrink: 0;
  width: 160px;
  height: 200px;
}
.bonus-modal .bonus-guide__image img {
  width: 100%;
  height: 100%;
  -o-object-fit: contain;
     object-fit: contain;
}
.bonus-modal__notice {
  padding: 12px 0 12px 24px;
  margin-bottom: 24px;
  border-left: 1px solid var(--red-100);
  font-size: 16px;
  letter-spacing: 0.2px;
  line-height: 120%;
  color: var(--gray-100);
}
.bonus-modal__notice strong {
  font-weight: 700;
}
.bonus-modal__total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background: var(--red-10);
  border: 1px solid var(--red-20);
  border-radius: 8px;
  margin-bottom: 24px;
}
.bonus-modal__total-label {
  font-size: 16px;
  letter-spacing: 0.2px;
  line-height: 120%;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--red-100);
}
.bonus-modal__total-value {
  font-weight: 600;
  font-size: 24px;
  line-height: 120%;
  letter-spacing: 0.2px;
  color: var(--red-100);
  font-weight: 600;
}
.bonus-modal__actions {
  display: flex;
  justify-content: center;
}
.bonus-modal__actions .button {
  text-transform: uppercase;
  font-size: 16px;
  display: flex;
  gap: 6px;
  align-items: center;
  color: var(--white-100);
  padding: 12px 63.5px;
  border: none;
  border-radius: 4px;
  background-color: var(--green-100);
  font-weight: 600;
  letter-spacing: 0.4px;
}
.bonus-modal__actions .button svg {
  width: 24px;
  height: 24px;
  color: var(--white-50);
}
.bonus-modal__description {
  font-size: 16px;
  letter-spacing: 0.2px;
  line-height: 120%;
  color: var(--black-100);
  margin-bottom: 24px;
}
.bonus-modal__inner {
  position: relative;
}
.bonus-modal__window {
  max-height: 90vh;
  overflow-y: scroll;
  padding: 48px;
  border-radius: 4px;
  position: relative;
  height: 800px;
  max-width: 1200px;
  z-index: 11;
  background-color: var(--white-100);
}
.bonus-modal__window::-webkit-scrollbar {
  height: 4px;
  width: 4px;
}
.bonus-modal__window::-webkit-scrollbar-track {
  background-color: transparent;
}
.bonus-modal__window::-webkit-scrollbar-thumb {
  background-color: var(--red-100);
}
.bonus-modal__window {
  scrollbar-width: thin;
  scrollbar-color: var(--red-100) transparent;
}
.bonus-modal .mobile-br {
  display: none;
}
@media screen and (max-width: 650px) {
  .bonus-modal .mobile-br {
    display: block;
  }
}

