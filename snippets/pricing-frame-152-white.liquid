<section id="pricing" class="pricing">
    <div class="pricing__image">
        <picture>
            <source media="(max-width: 650px)" srcset="{{ 'pricing-bg-mobile.avif' | file_url }}" type="image/avif">
            <source media="(max-width: 650px)" srcset="{{ 'pricing-bg-mobile.webp' | file_url }}" type="image/webp">
            <source srcset="{{ 'pricing-bg.avif' | file_url }}" type="image/avif">
            <img src="{{ 'pricing-bg.webp' | file_url }}" alt="Choose How You Start" fetchpriority="low" loading="lazy"
                decoding="async">
        </picture>
    </div>
    <div class="container">
        <h2 class="pricing__title">
            Choose How You Start
        </h2>

        <div class="pricing__cards">
            <article class="pricing-card pricing-card--subscription">
                <div class="pricing-card__image">
                    <picture>
                        <source srcset="{{ 'pricing-card-bg.avif' | file_url }}" type="image/avif">
                        <img src="{{ 'pricing-card-bg.webp' | file_url }}" alt="Api-Complex subscription"
                            fetchpriority="low" loading="lazy" decoding="async">
                    </picture>
                </div>
                <div class="pricing-card__gallery">
                    <button class="pricing-card__arrow pricing-card__arrow--dark--prev pricing-card__arrow--prev"
                        type="button">
                       <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M14.0472 17.6532L19.7012 11.9995L14.0472 6.3457L12.9934 7.4302L16.8127 11.2495H4.29717V12.7495H16.8127L12.9934 16.5687L14.0472 17.6532Z" fill="#121C3F" fill-opacity="0.5"/>
</svg>

                    </button>

                    <div class="pricing-card__slider pricing-card__slider-1 swiper">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'pricing-image-dark.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'pricing-image-dark.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'land-product-2-new.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'land-product-2-new.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'land-product-3-new.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'land-product-3-new.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'land-product-4-new.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'land-product-4-new.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'land-product-5-new.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'land-product-5-new.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                        </div>

                    </div>

                    <button class="pricing-card__arrow pricing-card__arrow--dark--next pricing-card__arrow--next"
                        type="button">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M14.0472 17.6532L19.7012 11.9995L14.0472 6.3457L12.9934 7.4302L16.8127 11.2495H4.29717V12.7495H16.8127L12.9934 16.5687L14.0472 17.6532Z" fill="#121C3F" fill-opacity="0.5"/>
</svg>

                    </button>
                </div>
                <div class="pricing-card-content-wrap">
                    <div class="pricing-card__pagination pricing-card__pagination--dark">

                    </div>

                    

                    {% comment %} <div class="pricing-card__price">
                        <span class="pricing-card__old-price">$149</span>

                        <div class="pricing-card__current-price">
                            <strong>$79</strong>
                            <span>/ per shipment</span>
                        </div>

                        <span class="pricing-card__saving pricing-card__saving--mobile">
                            save $70 / 47%
                        </span>
                    </div> {% endcomment %}
                    <div class="pricing-card__top">
                        <div class="pricing-card__left">
                            <span class="pricing-card__badge">
                                <svg>
                                    <use href="#like-icon"></use>
                                </svg>
                                <p>Best Value: <br> Smart Subscription</p>
                            </span>
                            <span class="pricing-card__saving">
                                save $70 / 47%
                            </span>
                            <p class="pricing-card__headline">
                                <strong>30 sticks <span>every 40 days —</span></strong> <br> your 30-on / 10-off cycle, <br>
                                running on autopilot for as long as you want
                            </p>
                        </div>
                        <div class="pricing-card__price">
                            <div class="pricing-card__old-price">$149</div>
                            <div class="pricing-card__current-price">
                                <strong>$79</strong>
                                <span>per shipment</span>
                            </div>
                        </div>
                    </div>
                    <p class="pricing-card__note pricing-card-box">
                        92% of subscribers continue past their first box
                    </p>
                    <div class="pricing-card-box pricing-card-main-box">
                        <p class="pricing-card__subtitle">
                            Full-strength hive dosing
                        </p>
                    
                        <ul class="pricing-card__features">
                            <li>
                                <svg>
                                    <use href="#check-icon"></use>
                                </svg>
                                Free shipping, every time
                            </li>
                            <li class="modal-item">
                                <svg>
                                    <use href="#check-icon"></use>
                                </svg>
                                <div>
                                    All bonuses included ($60 in extras)
                    
                                    <button type="button" class="bonus-modal-trigger" aria-controls="bonus-modal" aria-expanded="false">
                                        See what's inside
                                        <svg>
                                            <use href="#arrow-icon"></use>
                                        </svg>
                                    </button>
                                </div>
                    
                            </li>
                            <li>
                                <svg>
                                    <use href="#check-icon"></use>
                                </svg>
                                Founder Price Lock
                            </li>
                            <li>
                                <svg>
                                    <use href="#check-icon"></use>
                                </svg>
                                Guaranteed delivery, even when we sell out
                            </li>
                            <li>
                                <svg>
                                    <use href="#check-icon"></use>
                                </svg>
                                Skip, pause, or cancel anytime, in one click
                            </li>
                            <li>
                                <svg>
                                    <use href="#check-icon"></use>
                                </svg>
                                One stick, and the system works for you
                            </li>
                            <li>
                                <svg>
                                    <use href="#check-icon"></use>
                                </svg>
                                60-day money-back guarantee
                            </li>
                        </ul>
                    </div>
                    

                    <a class="pricing-card__button button" href="{% render 'api-complex-subscription-url' %}">
                        Start My First Cycle - $79
                        <svg>
                            <use href="#arrow-icon"></use>
                        </svg>
                    </a>
                </div>
            </article>

            <article class="pricing-card pricing-card--single">
                <div class="pricing-card__gallery">
                    <button class="pricing-card__arrow pricing-card__arrow--light--prev pricing-card__arrow--prev"
                        type="button">
                        <svg>
                            <use href="#arrow-icon"></use>
                        </svg>
                    </button>

                    <div class="pricing-card__slider pricing-card__slider-2 swiper">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'pricing-image-light.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'pricing-image-light.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'land-product-2-otp-new.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'land-product-2-otp-new.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'land-product-3-otp-new.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'land-product-3-otp-new.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'land-product-4-otp-new.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'land-product-4-otp-new.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                            <div class="swiper-slide">
                                <picture>
                                    <source srcset="{{ 'land-product-5-otp-new.avif' | file_url }}" type="image/avif">
                                    <img src="{{ 'land-product-5-otp-new.webp' | file_url }}" alt="Api-Complex subscription"
                                        fetchpriority="low" loading="lazy" decoding="async">
                                </picture>
                            </div>
                        </div>

                    </div>

                    <button class="pricing-card__arrow pricing-card__arrow--light--next pricing-card__arrow--next"
                        type="button">
                        <svg>
                            <use href="#arrow-icon"></use>
                        </svg>
                    </button>
                </div>
                <div class="pricing-card-content-wrap">

                
                <div class="pricing-card__pagination pricing-card__pagination--light">
                </div>
                <div class="pricing-card__top">
                    <div class="pricing-card__left">
                        <span class="pricing-card__badge">
                            One-Time Box
                        </span>
                        <span class="pricing-card__saving">
                            save $40 / 27%
                        </span>
                        <p class="pricing-card__headline">
                            <strong>30 sticks —</strong> <br> your first cycle to try the system
                        </p>
                    </div>
                    <div class="pricing-card__right">
                        <div class="pricing-card__price">
                            <div class="pricing-card__old-price">$149</div>
                            <div class="pricing-card__current-price">
                                <strong>$109</strong>
                                <span>+ $9.95 shipping</span>
                            </div>
                        </div>
                    </div>
                </div>

                

                

                

                <div class="pricing-card-box pricing-card-main-box">

                    <p class="pricing-card__subtitle">
                        Full-strength hive dosing
                    </p>


                    <ul class="pricing-card__features pricing-card__features--comparison">
                        <li class="pricing-card__feature pricing-card__feature--positive">
                            <svg>
                                <use href="#check-icon"></use>
                            </svg>
                            60-day money-back guarantee
                        </li>

                        <li class="pricing-card__feature pricing-card__feature--negative">
                            <svg>
                                <use href="#x-icon"></use>
                            </svg>
                            Bonuses
                        </li>

                        <li class="pricing-card__feature pricing-card__feature--negative">
                            <svg>
                                <use href="#x-icon"></use>
                            </svg>
                            Free shipping
                        </li>

                        <li class="pricing-card__feature pricing-card__feature--negative">
                            <svg>
                                <use href="#x-icon"></use>
                            </svg>
                            Price Lock
                        </li>
                    </ul>
                </div>
                <a class="pricing-card__button pricing-card__button--secondary button" href="/cart/54218299212144:1">
                    Buy One Box - $109
                    <svg>
                        <use href="#arrow-icon"></use>
                    </svg>
                </a>
                </div>
            </article>
        </div>
    </div>
</section>