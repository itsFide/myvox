@media screen and (max-width: 1919px){
   .jdgm-review-widget{
        max-width: 84.746vw !important;
    }
    .jm-review-widget-sidebar-header__title{
        font-size: 0.949vw !important; 
        
        padding: 0.508vw 0.814vw;
        
        border-radius: 0.271vw;
        border: 0.068vw solid rgba(69, 75, 96, 0.2);
    } 
}
@media screen and (max-width: 650px){
   .jdgm-review-widget{
        max-width: 100vw !important;
        padding:0 4.0712468193vw;
    } 
    .jm-review-widget-sidebar-header__title{
        font-size: 2.545vw !important; 
        
        padding: 2.545vw 3.053vw;
        
        border-radius: 1.018vw;
        border: 0.254vw solid rgba(69, 75, 96, 0.2);
    } 
} 
</style>
<link rel="preload" href="{{ 'Geologica-Light.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin="anonymous">
<link rel="preload" href="{{ 'Geologica-SemiBold.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin="anonymous">
<link rel="preload" href="{{ 'Geologica-Bold.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin="anonymous">
{% comment %} {{ 'theme-styles.css' | asset_url |  stylesheet_tag }} {% endcomment %}

{% if request.path == "/cart" or request.page_type == 'password' %}
    {{ 'base.css' | asset_url |  stylesheet_tag }}
{% endif %}

{% if request.path contains '/policies/' %}
    {{ 'polices.css' | asset_url |  stylesheet_tag }}
{% endif %}
<link rel="preload" href="{{ 'swiper-bundle.min.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>
  {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
</noscript>
