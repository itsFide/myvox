{% doc %}
  Styles the tracking form using the storefront's shared brand tokens.
  @example
  {% render 'track-order-styles' %}
{% enddoc %}

{% stylesheet %}
  .track-order {
    --track-order-background: var(--gray-bg-100, #f3f1f0);
    --track-order-text: var(--blue);
    --track-order-accent: var(--red);
    --track-order-border: color-mix(in srgb, var(--track-order-text) 20%, transparent);
    padding-block: clamp(40px, 5vw, 80px);
    background: var(--track-order-background);
    color: var(--track-order-text);
  }

  .tracking-widget {
    max-inline-size: 760px;
    margin-inline: auto;
    padding: clamp(24px, 4vw, 48px);
    background: var(--white);
    border: 1px solid var(--track-order-border);
    border-radius: 8px;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--track-order-text) 5%, transparent);
  }

  .track-order__title {
    margin-block-end: 12px;
    color: var(--track-order-text);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.4px;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .track-order__description {
    margin-block-end: 32px;
    color: color-mix(in srgb, var(--track-order-text) 80%, var(--white));
    font-size: 16px;
    line-height: 1.5;
    text-align: center;
  }

  .track-order__label {
    display: block;
    margin-block-end: 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .track-order__fields {
    display: flex;
    gap: 12px;
  }

  .track-order__input {
    flex: 1;
    min-inline-size: 0;
    inline-size: 100%;
    min-block-size: 48px;
    padding: 12px 16px;
    background: var(--white);
    border: 1px solid var(--track-order-border);
    border-radius: 4px;
    color: var(--track-order-text);
    font: inherit;
    font-size: 16px;
  }

  .track-order__input::placeholder {
    color: color-mix(in srgb, var(--track-order-text) 65%, var(--white));
    opacity: 1;
  }

  .track-order__button {
    min-block-size: 48px;
    padding: 12px 24px;
    background: var(--track-order-accent);
    border: 1px solid var(--track-order-accent);
    border-radius: 4px;
    color: var(--track-order-text);
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    cursor: pointer;
    overflow-wrap: anywhere;
  }

  .track-order__button:hover {
    background: var(--track-order-text);
    border-color: var(--track-order-text);
    color: var(--white);
  }

  .track-order__input:focus-visible,
  .track-order__button:focus-visible {
    outline: 2px solid var(--track-order-text);
    outline-offset: 3px;
  }

  .track-order__results:not(:empty) {
    margin-block-start: 32px;
    padding: 12px;
    background: var(--white);
    border: 1px solid var(--track-order-border);
    border-radius: 8px;
  }

  .track-order__results iframe {
    max-inline-size: 100%;
  }

  @media screen and (max-width: 650px) {
    .track-order__fields {
      flex-direction: column;
    }

    .track-order__button {
      inline-size: 100%;
    }
  }
{% endstylesheet %}
