<script>
  (function() {
    function initTriadModals() {
      const overlay = document.querySelector('.triad-modal-overlay');
      if (!overlay) return;

      const containers = overlay.querySelectorAll('.triad-modal__container');

      function openTriadModal(targetId) {
        let activeFound = false;
        containers.forEach(function(c) {
          if (c.id === `triad-modal-${targetId}` || c.getAttribute('data-triad-modal') === targetId) {
            c.classList.add('is-active');
            activeFound = true;
          } else {
            c.classList.remove('is-active');
          }
        });

        if (!activeFound && containers.length > 0) {
          containers[0].classList.add('is-active');
        }

        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.classList.add('triad-modal-open');
      }

      function closeTriadModal() {
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        containers.forEach(function(c) {
          c.classList.remove('is-active');
        });
        document.body.classList.remove('triad-modal-open');
      }

      document.addEventListener('click', function(e) {
        const triadLink = e.target.closest('.hive-triad__link');
        if (triadLink) {
          e.preventDefault();
          let target = triadLink.getAttribute('data-triad-target');
          if (!target) {
            const allLinks = Array.from(document.querySelectorAll('.hive-triad__link'));
            const idx = allLinks.indexOf(triadLink);
            const targets = ['bee-bread', 'royal-jelly', 'propolis'];
            target = targets[idx % 3];
          }
          openTriadModal(target);
          return;
        }

        if (e.target.closest('.triad-modal__close')) {
          closeTriadModal();
          return;
        }

        if (e.target === overlay) {
          closeTriadModal();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
          closeTriadModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTriadModals);
    } else {
      initTriadModals();
    }
  })();
</script>
