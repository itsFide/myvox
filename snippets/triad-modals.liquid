    }

    .triad-modal__list-icon {
        width: 1.6271vw;
        height: 1.6271vw;
        margin-top: 0.0678vw;
    }

    .triad-modal__bottom-text {
        font-size: 1.0847vw;
    }

    .triad-modal__cta-btn {
        margin-top: 1.6271vw;
        gap: 0.4068vw;
        padding: 0.5763vw 0.8136vw;
        border-radius: 0.2712vw;
