<style>
    .triad-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(18, 28, 63, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 99999;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
        padding: 20px;
        box-sizing: border-box;
    }

    .triad-modal-overlay.is-open {
        opacity: 1;
        visibility: visible;
    }

    body.triad-modal-open {
        overflow: hidden !important;
    }

    .triad-modal__container {
        display: none;
        width: 1200px;
        max-width: 100%;
        height: auto;
        max-height: calc(100vh - 40px);
        background: #FFFFFF;
        border-radius: 8px;
        padding: 48px;
        box-sizing: border-box;
        position: relative;
        overflow-y: auto;
        font-family: "Geologica", sans-serif;
    }

    .triad-modal__container.is-active {
        display: flex;
        gap: 24px;
        align-items: flex-start;
    }

    .triad-modal__close {
        position: absolute;
        top: 48px;
        right: 48px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        line-height: 0;
        z-index: 2;
        transition: opacity 0.2s ease;
    }

    .triad-modal__close:hover {
        opacity: 0.8;
    }

    .triad-modal__media {
        width: 345px;
        height: 400px;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .triad-modal__media picture,
    .triad-modal__media img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
    }

    .triad-modal__content {
        flex: 1;
        min-width: 0;
    }

    .triad-modal__title {
        font-family: "Geologica", sans-serif;
        font-size: 36px;
        font-weight: 600;
        line-height: 120%;
        color: #121C3F;
        margin: 0 0 12px 0;
        padding-right: 48px;
    }

    .triad-modal__description {
        font-family: "Geologica", sans-serif;
        font-size: 16px;
        line-height: 120%;
        font-weight: 300;
        color: #121C3F;
        margin: 0 0 12px 0;
    }

    .triad-modal__description strong {
        font-weight: 700;
    }

    .triad-modal__plate {
        padding: 6px 0 6px 24px;
        font-family: "Geologica", sans-serif;
        font-size: 16px;
        line-height: 120%;
        border-left: 1px solid #D16F55;
        color: #454B60;
        margin-bottom: 24px;
    }

    .triad-modal__study-link {
        color: #C0876C;
        pointer-events: none;
        text-decoration: none;
    }

    .triad-modal__orange-title {
        font-family: "Geologica", sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 120%;
        color: #D16F55;
        margin: 0 0 24px 0;
    }

    .triad-modal__list {
        list-style: none;
        padding: 0;
        margin: 0 0 24px 0;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .triad-modal__list-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-family: "Geologica", sans-serif;
        font-size: 16px;
        line-height: 120%;
        letter-spacing: 2%;
        color: rgba(18, 28, 63, 0.8);
    }

    .triad-modal__list-icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .triad-modal__bottom-text {
        font-family: "Geologica", sans-serif;
        font-size: 16px;
        line-height: 120%;
        color: rgba(18, 28, 63, 0.8);
        margin: 0;
    }

    .triad-modal__cta-btn {
        margin-top: 24px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #139EDF;
        padding: 8.5px 12px;
        background: rgba(19, 158, 223, 0.05);
        border-radius: 4px;
        font-family: "Geologica", sans-serif;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease;
        cursor: pointer;
    }

    .triad-modal__cta-btn:hover {
        background: rgba(19, 158, 223, 0.12);
    }

    .triad-modal__cta-icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
    }

