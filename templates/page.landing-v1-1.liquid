<section class="hero">
    <div class="hero__background">
        <picture>
            <source media="(max-width: 650px)" srcset="{{ 'hero-bg-mobile.avif' | file_url }}" type="image/avif">
            <source media="(max-width: 650px)" srcset="{{ 'hero-bg-mobile.webp' | file_url }}" type="image/webp">
            <source srcset="{{ 'hero-bg.avif' | file_url }}" type="image/avif">
            <img src="{{ 'hero-bg.webp' | file_url }}" alt="MYVOX-9" fetchpriority="high" loading="eager" decoding="async">
        </picture>
    </div>
    <div class="container">
        <div class="hero__inner">

            <div class="hero__content">

                <h1 class="hero__title">
                    <span>If you wake up <br class="mobile-br"> already exhausted,</span> <br>
                    your mornings <br> aren't the problem
                </h1>

                <p class="hero__description">
                    Api-Complex supports steady, natural energy, <br>
                    so mornings start easier instead of dragging.
                </p>

                <a class="hero__button button button--primary" href="#pricing">
                    TRY API-COMPLEX
