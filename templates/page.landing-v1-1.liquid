                    <source srcset="{{ 'hero-product-image.avif' | file_url }}" type="image/avif">
                    <source srcset="{{ 'hero-product-image.webp' | file_url }}" type="image/webp">
                    <img src="{{ 'hero-product-image.webp' | file_url }}" alt="MYVOX-9 Api-Complex product" loading="eager"
