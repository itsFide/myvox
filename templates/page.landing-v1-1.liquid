                    <div class="hero__badge-content">
                        <h3 class="hero__badge-title">
                            Third-party lab tested
                        </h3>
                        <a class="hero__badge-link" href="#" data-image-modal="https://cdn.shopify.com/s/files/1/1024/5387/0960/files/TR-261001-S11-01_Branded_page-0001.jpg?v=1793203192">
