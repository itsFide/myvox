                    <div class="hero__badge-content">
                        <h3 class="hero__badge-title">
                            cGMP-certified
                        </h3>
                    </div>
                </li>

                <li class="hero__badge">
                    <img src="{{ 'hero-icon-3.svg' | file_url }}" loading="lazy" class="hero__badge-icon"
